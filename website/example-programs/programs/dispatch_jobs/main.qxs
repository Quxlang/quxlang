LANGUAGE QUXLANG EN 0.0;

IMPORT std;

::main FUNCTION(): I32
{
  VAR jobs std::list#I32;
  jobs.push_back(100);
  jobs.push_back(101);
  jobs.push_front(99);
  LOOP WHILE (jobs.empty() == FALSE) DO
  {
    VAR job I32 := jobs.front();
    jobs.pop_front();
    std::printf#("dispatch {job}\n")(@job job);
  }
  RETURN 0;
}
