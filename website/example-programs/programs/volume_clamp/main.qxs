LANGUAGE QUXLANG EN 0.0;

IMPORT std;

::clamp FUNCTION(@value I32, @minimum I32, @maximum I32): I32
{
  IF (value < minimum)
  {
    RETURN minimum;
  }
  IF (value > maximum)
  {
    RETURN maximum;
  }
  RETURN value;
}

::main FUNCTION(): I32
{
  VAR volume I32 := clamp(@value 120, @minimum 0, @maximum 100);
  std::printf#("volume {volume}\n")(@volume volume);
  RETURN 0;
}
