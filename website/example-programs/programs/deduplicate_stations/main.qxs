LANGUAGE QUXLANG EN 0.0;

IMPORT std;

::main FUNCTION(): I32
{
  VAR stations std::set#I32;
  stations.insert(31);
  stations.insert(14);
  VAR inserted BOOL := stations.insert(31);
  std::printf#("{count} stations, repeated code added: {inserted}\n")(
    @count stations.size(), @inserted inserted);
  RETURN 0;
}
