LANGUAGE QUXLANG EN 0.0;

::lambda_no_capture_call FUNCTION(): I32
{
  RETURN (-< :I32 = 7)();
}

::lambda_implicit_reference_capture_call FUNCTION(): I32
{
  VAR x I32 := 4;
  RETURN (-< = x)();
}

::lambda_call_after_mutation FUNCTION(@callable:f AUTO(fn), @target:x MUT& I32): I32
{
  x := 9;
  RETURN f();
}

::lambda_explicit_reference_capture_call FUNCTION(): I32
{
  VAR x I32 := 4;
  RETURN lambda_call_after_mutation(@callable -< [x] = x, @target x);
}

::lambda_explicit_value_capture_call FUNCTION(): I32
{
  VAR x I32 := 4;
  RETURN lambda_call_after_mutation(@callable -< [=x] = x, @target x);
}

::lambda_nested_capture_bubbling_call FUNCTION(): I32
{
  VAR x I32 := 5;
  RETURN (-< = (-< = (-< = (-< = (-< = (-< = (-< = (-< = x)())())())())())())())();
}

::lambda_static_path_sensitive_capture_call FUNCTION(): I32
{
  VAR x I32 := 6;
  RETURN (-<
  {
    STATIC_IF(FALSE)
    {
      RETURN missing_symbol;
    }
    STATIC_ELSE
    {
      RETURN x;
    }
  })();
}

::lambda_unlisted_capture_rejected_call FUNCTION(): I32
{
  VAR x I32 := 1;
  RETURN (-< [] = x)();
}

::lambda_deduced_void_return_call FUNCTION()
{
  (-<
  {
  })();
}

::lambda_deduced_void_return_test STATIC_TEST
{
  lambda_deduced_void_return_call();
}

::lambda_no_capture_call_test DUAL_TEST
{
  TEST_ASSERT(lambda_no_capture_call() == 7);
}



::lambda_implicit_reference_capture_test DUAL_TEST
{
  TEST_ASSERT(lambda_implicit_reference_capture_call() == 4);
}



::lambda_explicit_reference_capture_test DUAL_TEST
{
  TEST_ASSERT(lambda_explicit_reference_capture_call() == 9);
}



::lambda_explicit_value_capture_test DUAL_TEST
{
  TEST_ASSERT(lambda_explicit_value_capture_call() == 4);
}



::lambda_nested_capture_bubbling_test DUAL_TEST
{
  TEST_ASSERT(lambda_nested_capture_bubbling_call() == 5);
}



::lambda_static_path_sensitive_capture_test DUAL_TEST
{
  TEST_ASSERT(lambda_static_path_sensitive_capture_call() == 6);
}



::lambda_unlisted_capture_rejected_test STATIC_TEST EXPECT_COMPILATION_FAILURE
{
  TEST_ASSERT(lambda_unlisted_capture_rejected_call() == 1);
}

::trailing_lambda_tests NAMESPACE
{
  ::repeat FUNCTION(@count I32, @CALLBACK AUTO)
  {
    LOOP INIT { VAR index I32 := 0; } WHILE(index < count) STEP { index++; } DO
    {
      CALLBACK();
    }
  }

  ::transform FUNCTION(@ARG:value I32, @CALLBACK:operation AUTO): I32
  {
    RETURN operation(value);
  }

  ::callback_arguments DUAL_TEST
  {
    VAR total I32 := 0;
    repeat(@count 0) { total := 100; };
    repeat(@count 2) { total += 3; };
    repeat(@count 1) -< [total] { total += 4; };
    AUTO increment := -< { total += 1; };
    repeat(@count 1, @CALLBACK increment);
    TEST_ASSERT(total == 11);

    VAR result I32 := transform(3) -< [=total] (@ARG:value I32): I32 { RETURN total + value; };
    TEST_ASSERT(result == 14);
    repeat(@count 1)
    {
      total := transform(2) -< (@ARG:value I32) { RETURN total + value; }
        - 1;
    };
    TEST_ASSERT(total == 12);
    TEST_ASSERT((transform(3) -< (@ARG:value I32) = value * 2) == 6);
  }

  ::duplicate_callback STATIC_TEST EXPECT_COMPILATION_FAILURE
  {
    repeat(@count 1, @CALLBACK -< {}) {};
  }
}
