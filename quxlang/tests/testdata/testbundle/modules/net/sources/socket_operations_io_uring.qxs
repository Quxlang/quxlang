LANGUAGE QUXLANG EN 0.0;

IMPORT io;
IMPORT std;
IMPORT syscall;

DOC <$
  Connects a TCP socket to an endpoint through the io_uring of an async_runtime2. The runtime uses io_uring. The socket and the
  storage named by the arguments outlive completion. A coroutine awaits the
  operation in its own frame, and the operation occupies a stable address until
  its result has been taken. Socket failures throw net::error from the await or
  from the future.
  $>
::io_uring_socket_connect INCLUDE_IF(OS_LINUX) STRUCT ROOTED NO_IMPLICIT_DEFAULT_CONSTRUCTOR
{
  DOC <$ Names the result type. $>
  ::value_type ALIAS VOID;

  PRIVATE(MODULE)
  {
    .completion VAR io::operation_completion;
    .socket VAR I32;
    DOC <$ Stores the errno of a failed request, or zero. $>
    .failure VAR U32;
    .peer VAR internet_address_storage;
    .length VAR U32;
  }

  DOC <$ Describes the operation without starting it. $>
  .CONSTRUCTOR FUNCTION(@runtime MUT& io::async_runtime2, @socket CONST& socket_operation_handle, @endpoint CONST& endpoint)
    :> .completion:(@runtime runtime)
  {
    .socket := socket;
    .length := encode_socket_address(@address .peer, @endpoint endpoint);
  }

  DOC <$ Encodes the request. The processor calls prepare during submission. $>
  .prepare FUNCTION(@entry MUT& syscall::linux::io_uring_submission_entry) MUT
  {
    entry.descriptor := .socket;
    entry.opcode := 16; // IORING_OP_CONNECT
    entry.address.value := IBC_GETADDR(@PTR .peer<-);
    entry.offset := .length AS U64;
  }

  DOC <$ Receives the completion of the request on the consumer thread. $>
  .on_notify FUNCTION(@completion io::io_uring_completion_result) MUT
  {
    IF (completion.result < 0) { .failure := (0 - completion.result) AS ASSUME U32; }
    .completion.finish();
  }

  DOC <$ Submits the request once. TRUE reports that the result is available without waiting. $>
  .start FUNCTION() MUT: BOOL
  {
    IF (.socket < 0) { THROW error::closed; }
    .completion.begin();
    TRY { .completion.runtime().submit_uring(@operation THIS); }
    CATCH failure CONST& io::io_uring_error
    {
      .completion.abandon();
      THROW io::async_error::submission_failed;
    }
    CATCH DEFAULT { .completion.abandon(); RETHROW; }
    RETURN FALSE;
  }

  DOC <$ Registers the continuation that completion notifies. FALSE reports that the operation completed first. $>
  .suspend FUNCTION(@continuation MUT->std::async_continuation) MUT: BOOL
  { RETURN .completion.suspend(@continuation continuation); }

  DOC <$ Returns the result of the completed operation, or throws its failure. $>
  .result FUNCTION() MUT
  {
    IF (.failure != 0) { THROW translate_socket_error(@code .failure AS I64); }

  }

  DOC <$ Starts the operation. $>
  .AWAIT_READY FUNCTION() MUT: BOOL { RETURN .start(); }
  DOC <$ Registers the awaiting coroutine. $>
  .AWAIT_SUSPEND FUNCTION(@CONTROLLER MUT& AUTO, @FRAME MUT& AUTO) MUT: BOOL
  { RETURN .completion.suspend(@continuation CONTROLLER.continuation()); }
  DOC <$ Returns the result after resumption, or throws the failure. $>
  .AWAIT_RESUME FUNCTION() MUT { .result(); }
  DOC <$ A started operation runs to completion. $>
  .TRY_CANCEL FUNCTION(@CONTROLLER MUT& AUTO, @FRAME MUT& AUTO) CONST NOEXCEPT: BOOL { RETURN FALSE; }
}

DOC <$
  Accepts one TCP connection from a listener through the io_uring of an async_runtime2. The runtime uses io_uring. The socket and the
  storage named by the arguments outlive completion. A coroutine awaits the
  operation in its own frame, and the operation occupies a stable address until
  its result has been taken. Socket failures throw net::error from the await or
  from the future.
  $>
::io_uring_socket_accept INCLUDE_IF(OS_LINUX) STRUCT ROOTED NO_IMPLICIT_DEFAULT_CONSTRUCTOR
{
  DOC <$ Names the result type. $>
  ::value_type ALIAS tcp_connection;

  PRIVATE(MODULE)
  {
    .completion VAR io::operation_completion;
    .socket VAR I32;
    DOC <$ Stores the errno of a failed request, or zero. $>
    .failure VAR U32;
    .accepted VAR I32;
  }

  DOC <$ Describes the operation without starting it. $>
  .CONSTRUCTOR FUNCTION(@runtime MUT& io::async_runtime2, @socket CONST& socket_operation_handle)
    :> .completion:(@runtime runtime)
  {
    .socket := socket;
  }

  DOC <$ Encodes the request. The processor calls prepare during submission. $>
  .prepare FUNCTION(@entry MUT& syscall::linux::io_uring_submission_entry) MUT
  {
    entry.descriptor := .socket;
    entry.opcode := 13; // IORING_OP_ACCEPT
    entry.operation_flags := 526336; // SOCK_NONBLOCK | SOCK_CLOEXEC
  }

  DOC <$ Receives the completion of the request on the consumer thread. An interrupted request is submitted again. $>
  .on_notify FUNCTION(@completion io::io_uring_completion_result) MUT
  {
    IF (completion.result == -4) // EINTR
    {
      TRY { .completion.runtime().submit_uring(@operation THIS); RETURN; }
      CATCH DEFAULT { .failure := 11; } // EAGAIN: the kernel did not accept the request again.
    }
    ELSE IF (completion.result < 0) { .failure := (0 - completion.result) AS ASSUME U32; }
    ELSE { .accepted := completion.result; }
    .completion.finish();
  }

  DOC <$ Submits the request once. TRUE reports that the result is available without waiting. $>
  .start FUNCTION() MUT: BOOL
  {
    IF (.socket < 0) { THROW error::closed; }
    .completion.begin();
    TRY { .completion.runtime().submit_uring(@operation THIS); }
    CATCH failure CONST& io::io_uring_error
    {
      .completion.abandon();
      THROW io::async_error::submission_failed;
    }
    CATCH DEFAULT { .completion.abandon(); RETHROW; }
    RETURN FALSE;
  }

  DOC <$ Registers the continuation that completion notifies. FALSE reports that the operation completed first. $>
  .suspend FUNCTION(@continuation MUT->std::async_continuation) MUT: BOOL
  { RETURN .completion.suspend(@continuation continuation); }

  DOC <$ Returns the result of the completed operation, or throws its failure. $>
  .result FUNCTION() MUT: tcp_connection
  {
    IF (.failure != 0) { THROW translate_socket_error(@code .failure AS I64); }
    RETURN tcp_connection(@reference tcp_connection_ref(@handle .accepted));
  }

  DOC <$ Starts the operation. $>
  .AWAIT_READY FUNCTION() MUT: BOOL { RETURN .start(); }
  DOC <$ Registers the awaiting coroutine. $>
  .AWAIT_SUSPEND FUNCTION(@CONTROLLER MUT& AUTO, @FRAME MUT& AUTO) MUT: BOOL
  { RETURN .completion.suspend(@continuation CONTROLLER.continuation()); }
  DOC <$ Returns the result after resumption, or throws the failure. $>
  .AWAIT_RESUME FUNCTION() MUT: tcp_connection { RETURN .result(); }
  DOC <$ A started operation runs to completion. $>
  .TRY_CANCEL FUNCTION(@CONTROLLER MUT& AUTO, @FRAME MUT& AUTO) CONST NOEXCEPT: BOOL { RETURN FALSE; }
}

DOC <$
  Reads available bytes from a TCP connection through the io_uring of an async_runtime2. The runtime uses io_uring. The socket and the
  storage named by the arguments outlive completion. A coroutine awaits the
  operation in its own frame, and the operation occupies a stable address until
  its result has been taken. Socket failures throw net::error from the await or
  from the future.
  $>
::io_uring_socket_read INCLUDE_IF(OS_LINUX) STRUCT ROOTED NO_IMPLICIT_DEFAULT_CONSTRUCTOR
{
  DOC <$ Names the result type. $>
  ::value_type ALIAS SZ;

  PRIVATE(MODULE)
  {
    .completion VAR io::operation_completion;
    .socket VAR I32;
    DOC <$ Stores the errno of a failed request, or zero. $>
    .failure VAR U32;
    .data VAR ADDRESS;
    .size VAR U32;
  }

  DOC <$ Describes the operation without starting it. $>
  .CONSTRUCTOR FUNCTION(@runtime MUT& io::async_runtime2, @socket CONST& socket_operation_handle, @buffer CONST& io::buffer_ref)
    :> .completion:(@runtime runtime)
  {
    .socket := socket;
    .data := IBC_GETADDR(@PTR buffer.data);
    .size := socket_transfer_size(@size buffer.size);
  }

  DOC <$ Encodes the request. The processor calls prepare during submission. $>
  .prepare FUNCTION(@entry MUT& syscall::linux::io_uring_submission_entry) MUT
  {
    entry.descriptor := .socket;
    entry.opcode := 27; // IORING_OP_RECV
    entry.operation_flags := 0;
    entry.address.value := .data;
    entry.length := .size;
  }

  DOC <$ Receives the completion of the request on the consumer thread. An interrupted request is submitted again. $>
  .on_notify FUNCTION(@completion io::io_uring_completion_result) MUT
  {
    IF (completion.result == -4) // EINTR
    {
      TRY { .completion.runtime().submit_uring(@operation THIS); RETURN; }
      CATCH DEFAULT { .failure := 11; } // EAGAIN: the kernel did not accept the request again.
    }
    ELSE IF (completion.result < 0) { .failure := (0 - completion.result) AS ASSUME U32; }
    ELSE { .size := completion.result AS ASSUME U32; }
    .completion.finish();
  }

  DOC <$ Submits the request once. TRUE reports that the result is available without waiting. $>
  .start FUNCTION() MUT: BOOL
  {
    IF (.socket < 0) { THROW error::closed; }
    IF (.size == 0) { RETURN TRUE; }
    .completion.begin();
    TRY { .completion.runtime().submit_uring(@operation THIS); }
    CATCH failure CONST& io::io_uring_error
    {
      .completion.abandon();
      THROW io::async_error::submission_failed;
    }
    CATCH DEFAULT { .completion.abandon(); RETHROW; }
    RETURN FALSE;
  }

  DOC <$ Registers the continuation that completion notifies. FALSE reports that the operation completed first. $>
  .suspend FUNCTION(@continuation MUT->std::async_continuation) MUT: BOOL
  { RETURN .completion.suspend(@continuation continuation); }

  DOC <$ Returns the result of the completed operation, or throws its failure. $>
  .result FUNCTION() MUT: SZ
  {
    IF (.failure != 0) { THROW translate_socket_error(@code .failure AS I64); }
    RETURN .size AS SZ;
  }

  DOC <$ Starts the operation. $>
  .AWAIT_READY FUNCTION() MUT: BOOL { RETURN .start(); }
  DOC <$ Registers the awaiting coroutine. $>
  .AWAIT_SUSPEND FUNCTION(@CONTROLLER MUT& AUTO, @FRAME MUT& AUTO) MUT: BOOL
  { RETURN .completion.suspend(@continuation CONTROLLER.continuation()); }
  DOC <$ Returns the result after resumption, or throws the failure. $>
  .AWAIT_RESUME FUNCTION() MUT: SZ { RETURN .result(); }
  DOC <$ A started operation runs to completion. $>
  .TRY_CANCEL FUNCTION(@CONTROLLER MUT& AUTO, @FRAME MUT& AUTO) CONST NOEXCEPT: BOOL { RETURN FALSE; }
}

DOC <$
  Writes bytes to a TCP connection through the io_uring of an async_runtime2. The runtime uses io_uring. The socket and the
  storage named by the arguments outlive completion. A coroutine awaits the
  operation in its own frame, and the operation occupies a stable address until
  its result has been taken. Socket failures throw net::error from the await or
  from the future.
  $>
::io_uring_socket_write INCLUDE_IF(OS_LINUX) STRUCT ROOTED NO_IMPLICIT_DEFAULT_CONSTRUCTOR
{
  DOC <$ Names the result type. $>
  ::value_type ALIAS SZ;

  PRIVATE(MODULE)
  {
    .completion VAR io::operation_completion;
    .socket VAR I32;
    DOC <$ Stores the errno of a failed request, or zero. $>
    .failure VAR U32;
    .data VAR ADDRESS;
    .size VAR U32;
  }

  DOC <$ Describes the operation without starting it. $>
  .CONSTRUCTOR FUNCTION(@runtime MUT& io::async_runtime2, @socket CONST& socket_operation_handle, @buffer CONST& io::buffer_ref)
    :> .completion:(@runtime runtime)
