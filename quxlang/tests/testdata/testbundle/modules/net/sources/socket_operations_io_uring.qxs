    }
    ELSE IF (completion.result < 0) { .failure := (0 - completion.result) AS ASSUME U32; }
    ELSE { .size := completion.result AS ASSUME U32; }
    .completion.finish();
  }

  DOC <$ Submits the request once. TRUE reports that the result is available without waiting. $>
  .start FUNCTION() MUT: BOOL
