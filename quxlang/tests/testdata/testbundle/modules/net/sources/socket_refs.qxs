      RETURN io::submit_operation#epoll_socket_receive(@runtime runtime, @socket .handle, @buffer buffer);
    }

    DOC <$ The receive coroutine awaits one receive operation in its own frame on the async_runtime2 of the calling coroutine. $>
    .receive INCLUDE_IF(kind == socket_kind::datagram && OS_MACOS)
      COROUTINE(@CONTROLLER io::async_controller2#AUTO(result_type), @buffer CONST& io::buffer_ref) CONST: datagram_result
    {
      VAR operation kqueue_socket_receive :(@runtime CONTROLLER.io_runtime(), @socket .handle, @buffer buffer);
      RETURN AWAIT(operation);
    }

    DOC <$ The receive coroutine awaits one receive operation in its own frame on the async_runtime2 of the calling coroutine. The operation type matches the mechanism that the runtime selected for the running kernel. $>
    .receive INCLUDE_IF(kind == socket_kind::datagram && OS_LINUX)
      COROUTINE(@CONTROLLER io::async_controller2#AUTO(result_type), @buffer CONST& io::buffer_ref) CONST: datagram_result
    {
      IF (CONTROLLER.io_runtime().uses_io_uring())
      {
        VAR ring_operation io_uring_socket_receive :(@runtime CONTROLLER.io_runtime(), @socket .handle, @buffer buffer);
        RETURN AWAIT(ring_operation);
      }
      ELSE
      {
        VAR ready_operation epoll_socket_receive :(@runtime CONTROLLER.io_runtime(), @socket .handle, @buffer buffer);
        RETURN AWAIT(ready_operation);
      }
    }
  }
}

DOC <$ The tcp_connection_ref type references a tcp connection without acquiring its closing obligation. $>
::tcp_connection_ref ALIAS socket_reference#(@kind socket_kind::connection);

DOC <$ The tcp_listener_ref type references a tcp listener without acquiring its closing obligation. $>
::tcp_listener_ref ALIAS socket_reference#(@kind socket_kind::listener);

DOC <$ The udp_session_ref type references a udp session without acquiring its closing obligation. $>
::udp_session_ref ALIAS socket_reference#(@kind socket_kind::datagram);

