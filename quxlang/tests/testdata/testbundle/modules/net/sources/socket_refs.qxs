    DOC <$ The write coroutine awaits one write operation in its own frame on the async_runtime2 of the calling coroutine. $>
    .write INCLUDE_IF(kind == socket_kind::connection && OS_MACOS)
      COROUTINE(@CONTROLLER io::async_controller2#AUTO(result_type), @buffer CONST& io::buffer_ref) CONST: SZ
    {
