      RETURN io::submit_operation#epoll_socket_send(@runtime runtime, @socket .handle, @buffer buffer, @destination destination);
    }

    DOC <$ The send coroutine awaits one send operation in its own frame on the async_runtime2 of the calling coroutine. $>
    .send INCLUDE_IF(kind == socket_kind::datagram && OS_MACOS)
      COROUTINE(@CONTROLLER io::async_controller2#AUTO(result_type), @buffer CONST& io::buffer_ref, @destination CONST& endpoint) CONST: SZ
    {
