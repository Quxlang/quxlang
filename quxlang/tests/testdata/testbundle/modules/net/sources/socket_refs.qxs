    DOC <$ The async_send function starts one send operation on the runtime and returns its future. The socket and referenced buffers outlive completion. $>
    .async_send INCLUDE_IF(kind == socket_kind::datagram && OS_MACOS)
      FUNCTION(@runtime MUT& io::async_runtime2, @buffer CONST& io::buffer_ref, @destination CONST& endpoint) CONST: std::future#SZ
    {
      RETURN io::submit_operation#kqueue_socket_send(@runtime runtime, @socket .handle, @buffer buffer, @destination destination);
    }

    DOC <$ The async_send function starts one send operation on the runtime and returns its future. The operation type matches the mechanism that the runtime selected for the running kernel. The socket and referenced buffers outlive completion. $>
    .async_send INCLUDE_IF(kind == socket_kind::datagram && OS_LINUX)
      FUNCTION(@runtime MUT& io::async_runtime2, @buffer CONST& io::buffer_ref, @destination CONST& endpoint) CONST: std::future#SZ
    {
