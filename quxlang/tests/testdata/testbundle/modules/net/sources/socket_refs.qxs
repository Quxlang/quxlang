    DOC <$ The send coroutine awaits one send operation in its own frame on the async_runtime2 of the calling coroutine. The operation type matches the mechanism that the runtime selected for the running kernel. $>
    .send INCLUDE_IF(kind == socket_kind::datagram && OS_LINUX)
      COROUTINE(@CONTROLLER io::async_controller2#AUTO(result_type), @buffer CONST& io::buffer_ref, @destination CONST& endpoint) CONST: SZ
    {
