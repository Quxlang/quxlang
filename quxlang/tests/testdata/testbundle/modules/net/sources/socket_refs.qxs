      }
      ELSE
      {
        VAR ready_operation epoll_socket_accept :(@runtime CONTROLLER.io_runtime(), @socket .handle);
        RETURN AWAIT(ready_operation);
      }
    }

    DOC <$ The async_read function starts one read operation on the runtime and returns its future. The socket and referenced buffers outlive completion. $>
    .async_read INCLUDE_IF(kind == socket_kind::connection && OS_MACOS)
      FUNCTION(@runtime MUT& io::async_runtime2, @buffer CONST& io::buffer_ref) CONST: std::future#SZ
    {
      RETURN io::submit_operation#kqueue_socket_read(@runtime runtime, @socket .handle, @buffer buffer);
    }

    DOC <$ The async_read function starts one read operation on the runtime and returns its future. The operation type matches the mechanism that the runtime selected for the running kernel. The socket and referenced buffers outlive completion. $>
    .async_read INCLUDE_IF(kind == socket_kind::connection && OS_LINUX)
      FUNCTION(@runtime MUT& io::async_runtime2, @buffer CONST& io::buffer_ref) CONST: std::future#SZ
    {
      IF (runtime.uses_io_uring())
      { RETURN io::submit_operation#io_uring_socket_read(@runtime runtime, @socket .handle, @buffer buffer); }
      RETURN io::submit_operation#epoll_socket_read(@runtime runtime, @socket .handle, @buffer buffer);
    }

    DOC <$ The read coroutine awaits one read operation in its own frame on the async_runtime2 of the calling coroutine. $>
    .read INCLUDE_IF(kind == socket_kind::connection && OS_MACOS)
      COROUTINE(@CONTROLLER io::async_controller2#AUTO(result_type), @buffer CONST& io::buffer_ref) CONST: SZ
    {
      VAR operation kqueue_socket_read :(@runtime CONTROLLER.io_runtime(), @socket .handle, @buffer buffer);
