    }

    DOC <$ The read coroutine awaits one read operation in its own frame on the async_runtime2 of the calling coroutine. The operation type matches the mechanism that the runtime selected for the running kernel. $>
    .read INCLUDE_IF(kind == socket_kind::connection && OS_LINUX)
      COROUTINE(@CONTROLLER io::async_controller2#AUTO(result_type), @buffer CONST& io::buffer_ref) CONST: SZ
    {
      IF (CONTROLLER.io_runtime().uses_io_uring())
      {
        VAR ring_operation io_uring_socket_read :(@runtime CONTROLLER.io_runtime(), @socket .handle, @buffer buffer);
        RETURN AWAIT(ring_operation);
      }
      ELSE
      {
        VAR ready_operation epoll_socket_read :(@runtime CONTROLLER.io_runtime(), @socket .handle, @buffer buffer);
        RETURN AWAIT(ready_operation);
      }
    }

    DOC <$ The async_write function starts one write operation on the runtime and returns its future. The socket and referenced buffers outlive completion. $>
    .async_write INCLUDE_IF(kind == socket_kind::connection && OS_MACOS)
      FUNCTION(@runtime MUT& io::async_runtime2, @buffer CONST& io::buffer_ref) CONST: std::future#SZ
    {
      RETURN io::submit_operation#kqueue_socket_write(@runtime runtime, @socket .handle, @buffer buffer);
    }

