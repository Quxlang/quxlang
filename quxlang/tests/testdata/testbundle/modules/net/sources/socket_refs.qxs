    DOC <$ The async_receive function starts one receive operation on the runtime and returns its future. The socket and referenced buffers outlive completion. $>
    .async_receive INCLUDE_IF(kind == socket_kind::datagram && OS_MACOS)
      FUNCTION(@runtime MUT& io::async_runtime2, @buffer CONST& io::buffer_ref) CONST: std::future#datagram_result
    {
      RETURN io::submit_operation#kqueue_socket_receive(@runtime runtime, @socket .handle, @buffer buffer);
    }

    DOC <$ The async_receive function starts one receive operation on the runtime and returns its future. The operation type matches the mechanism that the runtime selected for the running kernel. The socket and referenced buffers outlive completion. $>
    .async_receive INCLUDE_IF(kind == socket_kind::datagram && OS_LINUX)
