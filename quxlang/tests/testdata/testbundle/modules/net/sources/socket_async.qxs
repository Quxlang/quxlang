LANGUAGE QUXLANG EN 0.0;

IMPORT io;
IMPORT std;

PRIVATE(MODULE)
{
  DOC <$ Selects the completion storage of a socket coroutine at compile time. The I/O controller determines how the frame awaits its operation. $>
  ::socket_completion TEMPLATE(@controller_type TYPE AUTO, @operation_type TYPE AUTO) STRUCT ROOTED NO_IMPLICIT_DEFAULT_CONSTRUCTOR
  {
    .pending INCLUDE_IF(TYPE_HAS_MEMBER(controller_type, "io_runtime")) VAR io::native_waiter2#operation_type;
    .pending INCLUDE_IF(TYPE_HAS_MEMBER(controller_type, "io_runtime") == FALSE) VAR std::future#(operation_type::value_type);

    .CONSTRUCTOR INCLUDE_IF(TYPE_HAS_MEMBER(controller_type, "io_runtime"))
      FUNCTION(@controller MUT& controller_type, @operation MUT& operation_type)
      :> .pending:(@runtime controller.io_runtime(), @operation operation) {}
    .CONSTRUCTOR INCLUDE_IF(TYPE_HAS_MEMBER(controller_type, "io_runtime") == FALSE)
      FUNCTION(@controller MUT& controller_type, @operation MUT& operation_type)
      :> .pending:(@OTHER controller.submit(@operation MOVE(operation))) {}
  }
}
