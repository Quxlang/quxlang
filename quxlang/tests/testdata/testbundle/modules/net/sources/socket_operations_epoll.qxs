LANGUAGE QUXLANG EN 0.0;

IMPORT io;
IMPORT std;
IMPORT syscall;

DOC <$
  Connects a TCP socket to an endpoint through the epoll processor of an async_runtime2. The runtime does not use io_uring. The socket and
  the storage named by the arguments outlive completion. A coroutine awaits the
  operation in its own frame, and the operation occupies a stable address until
  its result has been taken. Socket failures throw net::error from the await or
  from the future.
  $>
::epoll_socket_connect INCLUDE_IF(OS_LINUX) STRUCT ROOTED NO_IMPLICIT_DEFAULT_CONSTRUCTOR
{
  DOC <$ Names the result type. $>
  ::value_type ALIAS VOID;

  PRIVATE(MODULE)
  {
    .completion VAR io::operation_completion;
    .socket VAR native_socket_ref;
    .failure VAR EXCEPTION_PTR;
    .destination VAR endpoint;

    DOC <$ Reads the outcome of the nonblocking connect after the socket becomes writable. FALSE reports that the socket is not ready. $>
    .attempt FUNCTION() MUT: BOOL
    {
      finish_socket_connect(@handle .socket);
      RETURN TRUE;
    }
  }

  DOC <$ Describes the operation without starting it. $>
  .CONSTRUCTOR FUNCTION(@runtime MUT& io::async_runtime2, @socket CONST& socket_operation_handle, @endpoint CONST& endpoint)
    :> .completion:(@runtime runtime), .destination:(@OTHER endpoint)
  {
    .socket := socket;
  }

  DOC <$ Returns the socket that the processor watches. $>
  .descriptor FUNCTION() CONST NOEXCEPT: io::io_descriptor_ref { RETURN io::io_descriptor_ref(@native_handle .socket); }

  DOC <$ Returns the condition that allows the operation to progress. $>
  .interest FUNCTION() CONST NOEXCEPT: io::epoll_events { RETURN io::epoll_events::writable; }

  DOC <$ Continues the operation after a readiness notification. The operation completes, or remains registered for another notification. $>
  .notify FUNCTION(@events io::epoll_events) MUT NOEXCEPT: io::operation_status
  {
    VAR finished BOOL := TRUE;
    TRY { finished := .attempt(); }
    CATCH DEFAULT { .failure := CURRENT_EXCEPTION(); }
    IF (finished == FALSE) { RETURN io::operation_status::pending; }
    .completion.finish();
    RETURN io::operation_status::finished;
  }

  DOC <$ Completes the operation with an I/O error after the processor could not continue its registration. $>
  .rearm_failed FUNCTION() MUT NOEXCEPT
  {
    TRY { THROW translate_socket_error(@code 5); } // EIO
    CATCH DEFAULT { .failure := CURRENT_EXCEPTION(); }
    .completion.finish();
  }

  DOC <$ Attempts the operation once. TRUE reports that the result is available without waiting. FALSE reports that the operation is registered for readiness. $>
  .start FUNCTION() MUT: BOOL
  {
    IF (connect_socket(@handle .socket, @endpoint .destination)) { RETURN TRUE; }
    .completion.begin();
    TRY { .completion.runtime().epoll().add(THIS); }
    CATCH failure CONST& io::epoll_error
    {
      .completion.abandon();
      THROW io::async_error::submission_failed;
    }
    CATCH DEFAULT { .completion.abandon(); RETHROW; }
    RETURN FALSE;
  }

  DOC <$ Registers the continuation that completion notifies. FALSE reports that the operation completed first. $>
  .suspend FUNCTION(@continuation MUT->std::async_continuation) MUT: BOOL
  { RETURN .completion.suspend(@continuation continuation); }

  DOC <$ Returns the result of the completed operation, or throws its failure. $>
  .result FUNCTION() MUT
  {
    IF (.failure??) { THROW_EXCEPTION_PTR(.failure); }

  }

  DOC <$ Starts the operation. $>
  .AWAIT_READY FUNCTION() MUT: BOOL { RETURN .start(); }
  DOC <$ Registers the awaiting coroutine. $>
  .AWAIT_SUSPEND FUNCTION(@CONTROLLER MUT& AUTO, @FRAME MUT& AUTO) MUT: BOOL
  { RETURN .completion.suspend(@continuation CONTROLLER.continuation()); }
  DOC <$ Returns the result after resumption, or throws the failure. $>
  .AWAIT_RESUME FUNCTION() MUT { .result(); }
  DOC <$ A started operation runs to completion. $>
  .TRY_CANCEL FUNCTION(@CONTROLLER MUT& AUTO, @FRAME MUT& AUTO) CONST NOEXCEPT: BOOL { RETURN FALSE; }
}

DOC <$
  Accepts one TCP connection from a listener through the epoll processor of an async_runtime2. The runtime does not use io_uring. The socket and
  the storage named by the arguments outlive completion. A coroutine awaits the
  operation in its own frame, and the operation occupies a stable address until
  its result has been taken. Socket failures throw net::error from the await or
  from the future.
  $>
::epoll_socket_accept INCLUDE_IF(OS_LINUX) STRUCT ROOTED NO_IMPLICIT_DEFAULT_CONSTRUCTOR
{
  DOC <$ Names the result type. $>
  ::value_type ALIAS tcp_connection;

  PRIVATE(MODULE)
  {
    .completion VAR io::operation_completion;
    .socket VAR native_socket_ref;
    .failure VAR EXCEPTION_PTR;
    .accepted VAR tcp_connection;

    DOC <$ Accepts a queued connection. FALSE reports that the socket is not ready. $>
    .attempt FUNCTION() MUT: BOOL
    {
      RETURN accept_socket(@handle .socket, @result .accepted);
    }
  }

  DOC <$ Describes the operation without starting it. $>
  .CONSTRUCTOR FUNCTION(@runtime MUT& io::async_runtime2, @socket CONST& socket_operation_handle)
    :> .completion:(@runtime runtime)
  {
    .socket := socket;
  }

  DOC <$ Returns the socket that the processor watches. $>
  .descriptor FUNCTION() CONST NOEXCEPT: io::io_descriptor_ref { RETURN io::io_descriptor_ref(@native_handle .socket); }

  DOC <$ Returns the condition that allows the operation to progress. $>
  .interest FUNCTION() CONST NOEXCEPT: io::epoll_events { RETURN io::epoll_events::readable; }

  DOC <$ Continues the operation after a readiness notification. The operation completes, or remains registered for another notification. $>
  .notify FUNCTION(@events io::epoll_events) MUT NOEXCEPT: io::operation_status
  {
    VAR finished BOOL := TRUE;
    TRY { finished := .attempt(); }
    CATCH DEFAULT { .failure := CURRENT_EXCEPTION(); }
    IF (finished == FALSE) { RETURN io::operation_status::pending; }
    .completion.finish();
    RETURN io::operation_status::finished;
  }

  DOC <$ Completes the operation with an I/O error after the processor could not continue its registration. $>
  .rearm_failed FUNCTION() MUT NOEXCEPT
  {
    TRY { THROW translate_socket_error(@code 5); } // EIO
    CATCH DEFAULT { .failure := CURRENT_EXCEPTION(); }
    .completion.finish();
  }

  DOC <$ Attempts the operation once. TRUE reports that the result is available without waiting. FALSE reports that the operation is registered for readiness. $>
  .start FUNCTION() MUT: BOOL
  {
    IF (.attempt()) { RETURN TRUE; }
    .completion.begin();
    TRY { .completion.runtime().epoll().add(THIS); }
    CATCH failure CONST& io::epoll_error
    {
      .completion.abandon();
      THROW io::async_error::submission_failed;
    }
    CATCH DEFAULT { .completion.abandon(); RETHROW; }
    RETURN FALSE;
  }

  DOC <$ Registers the continuation that completion notifies. FALSE reports that the operation completed first. $>
  .suspend FUNCTION(@continuation MUT->std::async_continuation) MUT: BOOL
  { RETURN .completion.suspend(@continuation continuation); }

  DOC <$ Returns the result of the completed operation, or throws its failure. $>
  .result FUNCTION() MUT: tcp_connection
  {
    IF (.failure??) { THROW_EXCEPTION_PTR(.failure); }
    VAR accepted MUT& tcp_connection := .accepted;
    RETURN MOVE(accepted);
  }

  DOC <$ Starts the operation. $>
  .AWAIT_READY FUNCTION() MUT: BOOL { RETURN .start(); }
  DOC <$ Registers the awaiting coroutine. $>
  .AWAIT_SUSPEND FUNCTION(@CONTROLLER MUT& AUTO, @FRAME MUT& AUTO) MUT: BOOL
  { RETURN .completion.suspend(@continuation CONTROLLER.continuation()); }
  DOC <$ Returns the result after resumption, or throws the failure. $>
  .AWAIT_RESUME FUNCTION() MUT: tcp_connection { RETURN .result(); }
  DOC <$ A started operation runs to completion. $>
  .TRY_CANCEL FUNCTION(@CONTROLLER MUT& AUTO, @FRAME MUT& AUTO) CONST NOEXCEPT: BOOL { RETURN FALSE; }
}

DOC <$
  Reads available bytes from a TCP connection through the epoll processor of an async_runtime2. The runtime does not use io_uring. The socket and
  the storage named by the arguments outlive completion. A coroutine awaits the
  operation in its own frame, and the operation occupies a stable address until
  its result has been taken. Socket failures throw net::error from the await or
  from the future.
  $>
::epoll_socket_read INCLUDE_IF(OS_LINUX) STRUCT ROOTED NO_IMPLICIT_DEFAULT_CONSTRUCTOR
{
  DOC <$ Names the result type. $>
  ::value_type ALIAS SZ;

  PRIVATE(MODULE)
  {
    .completion VAR io::operation_completion;
    .socket VAR native_socket_ref;
    .failure VAR EXCEPTION_PTR;
    .buffer VAR io::buffer_ref;
    .size VAR SZ;

    DOC <$ Reads the bytes that are available. FALSE reports that the socket is not ready. $>
    .attempt FUNCTION() MUT: BOOL
    {
      RETURN transfer_socket#(@writing FALSE)(@handle .socket, @buffer .buffer, @result .size);
    }
  }

  DOC <$ Describes the operation without starting it. $>
  .CONSTRUCTOR FUNCTION(@runtime MUT& io::async_runtime2, @socket CONST& socket_operation_handle, @buffer CONST& io::buffer_ref)
