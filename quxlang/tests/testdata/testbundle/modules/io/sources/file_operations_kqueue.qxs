  DOC <$ Issues the transfer once. TRUE reports that the result is available without waiting, which occurs when the descriptor or the offset is rejected. $>
  .start FUNCTION() MUT: BOOL
  {
    IF (.descriptor.is_valid() == FALSE) { .outcome.error := 9; RETURN TRUE; } // EBADF
    IF (.offset > 9223372036854775807) { .outcome.error := 22; RETURN TRUE; } // EINVAL
    VAR backend MUT& runtime_backend := .completion.runtime().backend;
    .completion.begin();
    IF (backend.native_aio)
    {
      VAR code I32 := backend.processor.write(@request .request, @descriptor .descriptor,
        @buffer .buffer, @offset .offset, @target .target);
      IF (code == 0) { RETURN FALSE; }
      // EAGAIN reports that the process has reached its limit of queued transfers.
      IF (code != 35)
      {
        .completion.abandon();
        .outcome.error := code AS ASSUME U32;
        RETURN TRUE;
      }
    }
    TRY { backend.file_work.submit(@work .work<-); }
    CATCH DEFAULT { .completion.abandon(); RETHROW; }
    RETURN FALSE;
  }

  DOC <$ Registers the continuation that completion notifies. FALSE reports that the transfer completed first. $>
  .suspend FUNCTION(@continuation MUT->std::async_continuation) MUT: BOOL
  { RETURN .completion.suspend(@continuation continuation); }

  DOC <$ Returns the outcome of the completed transfer. $>
  .result FUNCTION() MUT: transfer_result { RETURN .outcome; }

  DOC <$ Starts the transfer. $>
  .AWAIT_READY FUNCTION() MUT: BOOL { RETURN .start(); }
  DOC <$ Registers the awaiting coroutine. $>
  .AWAIT_SUSPEND FUNCTION(@CONTROLLER MUT& AUTO, @FRAME MUT& AUTO) MUT: BOOL
  { RETURN .completion.suspend(@continuation CONTROLLER.continuation()); }
  DOC <$ Returns the outcome after resumption. $>
  .AWAIT_RESUME FUNCTION() MUT: transfer_result { RETURN .outcome; }
  DOC <$ A started transfer runs to completion. $>
  .TRY_CANCEL FUNCTION(@CONTROLLER MUT& AUTO, @FRAME MUT& AUTO) CONST NOEXCEPT: BOOL { RETURN FALSE; }
}
