LANGUAGE QUXLANG EN 0.0;

IMPORT std;

IMPORT syscall;


PRIVATE(MODULE)
{
  DOC <$ Protects completion-port bindings and native handle closure. $>
  ::windows_completion_bindings_mutex INCLUDE_IF(OS_WINDOWS) VAR std::ordering_mutex;

  DOC <$ Maps each open handle to the identity of its completion port. $>
  ::windows_completion_bindings INCLUDE_IF(OS_WINDOWS) VAR std::map#(@INDEX SZ, @VALUE U64);

  DOC <$ Assigns distinct identities even when Windows reuses a closed port's handle value. $>
  ::windows_completion_last_identity INCLUDE_IF(OS_WINDOWS) VAR U64;

  DOC <$
    Owns one Windows I/O completion port.
    $>
  ::windows_async_context_state INCLUDE_IF(OS_WINDOWS)
    STRUCT MOVE_ONLY
  {
    .completion_port VAR ADDRESS;
    .identity VAR U64;
  }

  DOC <$
    Creates an I/O completion port with the requested worker concurrency.
    $>
  ::initialize_windows_async_context INCLUDE_IF(OS_WINDOWS)
    FUNCTION(
      @state MUT& windows_async_context_state,
      @concurrency U32
    ): BOOL
  {
    VAR null_address ADDRESS;
    VAR invalid_file_handle ADDRESS := null_address - (1 AS SZ);
    state.completion_port := syscall::windows::create_io_completion_port(
      @file_handle invalid_file_handle,
      @existing_completion_port null_address,
      @completion_key 0,
      @concurrent_threads concurrency
    );
    IF (state.completion_port!?) { RETURN FALSE; }
    windows_completion_bindings_mutex.lock();
    windows_completion_last_identity++;
    state.identity := windows_completion_last_identity;
    windows_completion_bindings_mutex.unlock();
    RETURN TRUE;
  }

  DOC <$
    Associates an overlapped handle once per open lifetime. An existing binding
    succeeds only when it names this completion port.
    $>
  ::associate_windows_async_file INCLUDE_IF(OS_WINDOWS)
    FUNCTION(
      @state CONST& windows_async_context_state,
      @descriptor io_descriptor_ref
    ): BOOL
  {
    IF (descriptor.is_valid() == FALSE) { RETURN FALSE; }
    VAR handle ADDRESS := descriptor.native_handle();
    VAR key SZ := handle - (NULL AS ADDRESS);
    windows_completion_bindings_mutex.lock();
    DEFER { windows_completion_bindings_mutex.unlock(); }
    VAR binding MUT& U64 := windows_completion_bindings[key];
    IF (binding != 0) { RETURN binding == state.identity; }
    VAR associated ADDRESS := syscall::windows::create_io_completion_port(
      @file_handle handle,
      @existing_completion_port state.completion_port,
      @completion_key 0,
      @concurrent_threads 0
    );
    IF (associated != state.completion_port)
    {
      windows_completion_bindings.erase(@key key);
      RETURN FALSE;
    }
    binding := state.identity;
    RETURN TRUE;
  }

  DOC <$
    Initializes a request's OVERLAPPED state for one positioned transfer.
    $>
  ::prepare_windows_overlapped INCLUDE_IF(OS_WINDOWS)
    FUNCTION(
      @request MUT->async_request,
      @offset U64
    )
  {
    VAR overlapped_address ADDRESS := IBC_GETADDR(@PTR request->.windows_overlapped<-);
    ASSERT(overlapped_address == async_request_address(@request request),
      "The IOCP OVERLAPPED field must remain first in async request state.");
    request->.windows_overlapped.internal := 0;
    request->.windows_overlapped.internal_high := 0;
    request->.windows_overlapped.offset := offset AS PARTIAL U32;
    request->.windows_overlapped.offset_high :=
      (offset #-- 32) AS ASSUME U32;
    VAR null_event ADDRESS;
    request->.windows_overlapped.event := null_event;
  }

  DOC <$
    Treats immediate success and ERROR_IO_PENDING as accepted overlapped I/O.
    $>
  ::windows_async_submission_accepted INCLUDE_IF(OS_WINDOWS)
    FUNCTION(@immediate_success BOOL): BOOL
  {
    IF (immediate_success)
    {
      RETURN TRUE;
    }
    RETURN syscall::windows::get_last_error() == 997;
  }

  DOC <$
    Starts one positioned overlapped read whose result is delivered by IOCP.
    $>
  ::submit_async_read INCLUDE_IF(OS_WINDOWS)
    FUNCTION(
      @request MUT->async_request,
      @descriptor io_descriptor_ref,
      @buffer CONST& buffer_ref,
      @offset U64
    ): BOOL
  {
    prepare_windows_overlapped(@request request, @offset offset);
    VAR immediate_bytes U32 := 0;
    VAR immediate_success BOOL := syscall::windows::read_file(
      @handle descriptor.native_handle(),
      @buffer buffer.data,
      @count async_transfer_size(@size buffer.size),
      @transferred immediate_bytes<-,
      @overlapped request->.windows_overlapped<-
    ) != 0;
    RETURN windows_async_submission_accepted(
      @immediate_success immediate_success
    );
  }

  DOC <$
    Starts one positioned overlapped write whose result is delivered by IOCP.
    $>
  ::submit_async_write INCLUDE_IF(OS_WINDOWS)
    FUNCTION(
      @request MUT->async_request,
      @descriptor io_descriptor_ref,
      @buffer CONST& buffer_ref,
      @offset U64
    ): BOOL
  {
    prepare_windows_overlapped(@request request, @offset offset);
    VAR immediate_bytes U32 := 0;
    VAR immediate_success BOOL := syscall::windows::write_file(
      @handle descriptor.native_handle(),
      @buffer buffer.data,
      @count async_transfer_size(@size buffer.size),
      @transferred immediate_bytes<-,
      @overlapped request->.windows_overlapped<-
    ) != 0;
    RETURN windows_async_submission_accepted(
      @immediate_success immediate_success
    );
  }

  DOC <$
    Removes one IOCP packet, executes its callback, and returns false only for
    an explicit thread-pool stop packet.
    $>
  ::wait_for_async_completion INCLUDE_IF(OS_WINDOWS)
    FUNCTION(@control MUT->async_context_control): BOOL
  {
    VAR transferred U32 := 0;
    VAR completion_key UINTPTR := 0;
    VAR overlapped MUT->syscall::windows::overlapped;
    VAR succeeded BOOL := syscall::windows::get_queued_completion_status(
      @completion_port control->.windows.completion_port,
      @transferred transferred<-,
      @completion_key completion_key<-,
      @overlapped overlapped<-,
      @milliseconds (0 AS U32) #!!
    ) != 0;
    IF ((overlapped??) == FALSE)
    {
      IF (succeeded)
      {
        RETURN FALSE;
      }
      PANIC "GetQueuedCompletionStatus failed without an I/O completion.";
    }

    VAR request_address ADDRESS := IBC_GETADDR(@PTR overlapped);
    VAR request MUT->async_request := async_request_at(@address request_address);
    IF (request->.native??)
    {
      VAR failure U32;
      IF (succeeded == FALSE) { failure := syscall::windows::get_last_error(); }
      complete_native_operation(@request request, @size transferred AS SZ, @error failure);
      RETURN TRUE;
    }
    VAR result_size SZ := 0;
    IF (succeeded)
    {
      ASSERT((transferred AS SZ) <= request->.buffer.size,
        "Overlapped completion exceeded the submitted byte count.");
      result_size := transferred AS SZ;
    }
    complete_async_request(
      @request request,
      @succeeded succeeded,
      @size result_size
    );
    RETURN TRUE;
  }

  DOC <$
    Posts one null-OVERLAPPED completion packet per worker that must stop.
    $>
  ::request_async_stop INCLUDE_IF(OS_WINDOWS)
    FUNCTION(
      @control MUT->async_context_control,
      @worker_count SZ
    )
  {
    VAR null_overlapped MUT->syscall::windows::overlapped;
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(worker_count) DO
    {
      IF (syscall::windows::post_queued_completion_status(
        @completion_port control->.windows.completion_port,
        @transferred 0,
        @completion_key 0,
        @overlapped null_overlapped
      ) == 0)
      {
        THROW async_error::worker_stop_failed;
      }
    };
  }

  DOC <$
    Closes a drained Windows I/O completion port.
    $>
  ::shutdown_async_context INCLUDE_IF(OS_WINDOWS)
    FUNCTION(@control MUT->async_context_control)
  {
    IF (syscall::windows::close_handle(@handle control->.windows.completion_port) == 0)
    {
      THROW async_error::resource_release_failed;
    }
    VAR null_port ADDRESS;
    control->.windows.completion_port := null_port;
    control->.valid := FALSE;
  }
}

DOC <$
  Closes a Windows handle under the completion-port binding lock. close performs
  the native close operation for handle and returns true on success. All I/O on
  the handle has completed before this call. A failed close preserves the binding.
  $>
::close_windows_async_handle INCLUDE_IF(OS_WINDOWS)
  FUNCTION(@handle ADDRESS, @close AUTO& AUTO): BOOL
{
  windows_completion_bindings_mutex.lock();
  DEFER { windows_completion_bindings_mutex.unlock(); }
  IF (close() == FALSE) { RETURN FALSE; }
  VAR key SZ := handle - (NULL AS ADDRESS);
  windows_completion_bindings.erase(@key key);
  RETURN TRUE;
}
