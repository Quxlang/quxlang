LANGUAGE QUXLANG EN 0.0;

IMPORT std;

IMPORT syscall;

DOC <$
  Reports the outcome of one file transfer. A successful transfer may contain
  fewer bytes than requested, including zero bytes at end of file.
  $>
::transfer_result STRUCT
{
  .size VAR SZ;
  .succeeded VAR BOOL;
  DOC <$ Stores the native error code of a failed transfer: the errno value on Linux and macOS, and the system error code on Windows. A successful transfer stores zero. The async_runtime transfers store zero for every outcome. $>
  .error VAR U32;
}

PRIVATE(MODULE)
{
  DOC <$ Recovers the errno value from the raw result of a failed Linux transfer, which is its negation. $>
  ::posix_transfer_error INCLUDE_IF(OS_LINUX) FUNCTION(@size SZ): U32 { RETURN async_transfer_size(@size (0 AS SZ) - size); }
  DOC <$ Reads the errno value that Darwin recorded for the calling thread's failed transfer. $>
  ::posix_transfer_error INCLUDE_IF(OS_MACOS) FUNCTION(@size SZ): U32 { RETURN syscall::macos::errno_location()-> AS ASSUME U32; }
}

DOC <$
  A non-owning reference to a mutable byte range. The referenced storage must
  remain alive for every operation that uses the reference.
  $>
::buffer_ref STRUCT
{
  .data VAR MUT=>>BYTE;
  .size VAR SZ;

  DOC <$ Creates a reference to data[0..size). $>
  .CONSTRUCTOR FUNCTION(@data MUT=>>BYTE, @size SZ)
  {
    .data := data;
    .size := size;
  }
}

::java_file INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_TYPE["java.base":"java/io/File"];

::java_random_access_file INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_TYPE["java.base":"java/io/RandomAccessFile"];

::jvm_file_create_temp_file INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/File":"createTempFile"]
  CALLABLE CALLCONV JVM_STATIC(
    @prefix ~> RUNTIME_MODULE::java_string,
    @suffix ~> RUNTIME_MODULE::java_string;
    RETURN ~> java_file
  );

::jvm_file_get_path INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/File":"getPath"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_file;
    RETURN ~> RUNTIME_MODULE::java_string
  );

::jvm_file_delete_on_exit INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/File":"deleteOnExit"]
  CALLABLE CALLCONV JVM_VIRTUAL(@THIS ~> java_file);

::jvm_random_access_file_constructor INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"<init>"]
  CALLABLE CALLCONV JVM_CONSTRUCTOR(
    @path ~> RUNTIME_MODULE::java_string,
    @mode ~> RUNTIME_MODULE::java_string;
    RETURN ~> java_random_access_file
  );

::jvm_random_access_file_read INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"read"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_random_access_file;
    RETURN I32
  );

::jvm_random_access_file_write INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"write"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_random_access_file,
    @value I32
  );

::jvm_random_access_file_length INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"length"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_random_access_file;
    RETURN I64
  );

::jvm_random_access_file_set_length INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"setLength"]
  CALLABLE CALLCONV JVM_VIRTUAL(
    @THIS ~> java_random_access_file,
    @length I64
  );

::jvm_random_access_file_close INCLUDE_IF(ARCH_IS_JVM)
  EXTERN_PROCEDURE["java/io/RandomAccessFile":"close"]
  CALLABLE CALLCONV JVM_VIRTUAL(@THIS ~> java_random_access_file);

PRIVATE(MODULE)
{
  ::file_processor_error2 INCLUDE_IF(OS_WINDOWS) ALIAS overlapped_error;

  DOC <$ Borrows the runtime selected by the file coroutine's controller. $>
  ::file_transfer_runtime INCLUDE_IF(OS_LINUX || OS_MACOS || OS_WINDOWS)
    FUNCTION(@controller MUT& async_controller#AUTO(result_type)): MUT& async_runtime { RETURN controller.runtime->; }
  ::file_transfer_runtime INCLUDE_IF(OS_LINUX || OS_MACOS || OS_WINDOWS)
    FUNCTION(@controller MUT& async_controller2#AUTO(result_type)): MUT& async_runtime2 { RETURN controller.io_runtime(); }

  DOC <$ Stores the positioned transfer and its completion in the calling file coroutine. The controller selects either a frame-local native request or a future. $>
  ::positioned_file_transfer INCLUDE_IF(OS_WINDOWS)
    TEMPLATE(@writing VALUE BOOL, @controller_type TYPE AUTO) STRUCT ROOTED NO_IMPLICIT_DEFAULT_CONSTRUCTOR
  {
    .pending INCLUDE_IF(TYPE_HAS_MEMBER(controller_type, "io_runtime")) VAR transfer_waiter2;
    .pending INCLUDE_IF(TYPE_HAS_MEMBER(controller_type, "io_runtime") == FALSE) VAR std::future#transfer_result;

    .CONSTRUCTOR FUNCTION(@controller MUT& controller_type, @descriptor CONST& io_descriptor_ref, @buffer CONST& buffer_ref, @offset U64)
    {
      STATIC_IF(TYPE_HAS_MEMBER(controller_type, "io_runtime"))
      {
        VAR runtime MUT& async_runtime2 := controller.io_runtime();
        TRY
        {
          VAR binding := runtime.bind(@descriptor descriptor);
          STATIC_IF(writing) { runtime.write(@file binding, @request .pending.request, @buffer buffer, @offset offset); }
          STATIC_ELSE { runtime.read(@file binding, @request .pending.request, @buffer buffer, @offset offset); }
        }
        CATCH failure CONST& async_error { .pending.complete(@result transfer_result()); }
        CATCH failure CONST& file_processor_error2 { .pending.complete(@result transfer_result()); }
      }
      STATIC_ELSE
      {
        VAR runtime MUT& async_runtime := controller.runtime->;
        STATIC_IF(writing) { .pending := runtime.write(@descriptor descriptor, @buffer buffer, @offset offset); }
        STATIC_ELSE { .pending := runtime.read(@descriptor descriptor, @buffer buffer, @offset offset); }
      }
    }
  }
}

DOC <$ Borrows an open native file descriptor or Windows file handle. The caller owns its lifetime. $>
::file_ref INCLUDE_IF(OS_LINUX || OS_MACOS || OS_WINDOWS) STRUCT
{
  .descriptor VAR io_descriptor_ref;

  DOC <$ Creates an empty resource reference. $>
  .CONSTRUCTOR FUNCTION() {}

  DOC <$ Borrows descriptor without acquiring ownership. $>
  .CONSTRUCTOR FUNCTION(@descriptor AUTO& io_descriptor_ref) :> .descriptor:(@OTHER FORWARD(descriptor)) {}

  DOC <$ Reports whether the stored descriptor is valid. $>
  .is_valid FUNCTION() CONST: BOOL { RETURN .descriptor.is_valid(); }

  DOC <$ Reads at most buffer.size bytes into buffer and stores the outcome in result. $>
  .read INCLUDE_IF(OS_LINUX || OS_MACOS) FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    outcome.size := posix_filesystem::read(
      @fd .descriptor.native_handle(),
      @buffer buffer.data,
      @count buffer.size
    );
    outcome.succeeded := outcome.size <= buffer.size;
    IF (outcome.succeeded == FALSE)
    {
      outcome.error := posix_transfer_error(@size outcome.size);
      outcome.size := 0;
    }
    result := outcome;
  }

  DOC <$ Writes at most buffer.size bytes from buffer and stores the outcome in result. $>
  .write INCLUDE_IF(OS_LINUX || OS_MACOS) FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    outcome.size := posix_filesystem::write(
      @fd .descriptor.native_handle(),
      @buffer buffer.data,
      @count buffer.size
    );
    outcome.succeeded := outcome.size <= buffer.size;
    IF (outcome.succeeded == FALSE)
    {
      outcome.error := posix_transfer_error(@size outcome.size);
      outcome.size := 0;
    }
    result := outcome;
  }

  DOC <$
    Closes the referenced descriptor. This operation does not track whether
    another file_ref still refers to the same descriptor.
    $>
  .close INCLUDE_IF(OS_LINUX || OS_MACOS) FUNCTION(): BOOL
  {
    RETURN posix_filesystem::close(@fd .descriptor.native_handle()) == 0;
  }

  DOC <$ Reads at most buffer.size bytes into buffer and stores the outcome in result. $>
  .read INCLUDE_IF(OS_WINDOWS) FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    VAR transferred U32 := 0;
    VAR overlapped MUT->syscall::windows::overlapped;
    outcome.succeeded := syscall::windows::read_file(
      @handle .descriptor.native_handle(),
      @buffer buffer.data,
      @count windows_transfer_size(@size buffer.size),
      @transferred transferred<-,
      @overlapped overlapped
    ) != 0;
    IF (outcome.succeeded == FALSE) { outcome.error := syscall::windows::get_last_error(); }
    outcome.size := transferred AS SZ;
    result := outcome;
  }

  DOC <$ Writes at most buffer.size bytes from buffer and stores the outcome in result. $>
  .write INCLUDE_IF(OS_WINDOWS) FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    VAR transferred U32 := 0;
    VAR overlapped MUT->syscall::windows::overlapped;
    outcome.succeeded := syscall::windows::write_file(
      @handle .descriptor.native_handle(),
      @buffer buffer.data,
      @count windows_transfer_size(@size buffer.size),
      @transferred transferred<-,
      @overlapped overlapped
    ) != 0;
    IF (outcome.succeeded == FALSE) { outcome.error := syscall::windows::get_last_error(); }
    outcome.size := transferred AS SZ;
    result := outcome;
  }

  DOC <$
    Closes the referenced Windows handle and invalidates copies of its descriptor.
    $>
  .close INCLUDE_IF(OS_WINDOWS) FUNCTION(): BOOL
  {
    RETURN .descriptor.close_windows_handle(
      @close -< [] (@handle ADDRESS): BOOL = syscall::windows::close_handle(@handle handle) != 0);
  }

  DOC <$ Submits a positioned read to the selected I/O runtime and stores the completed transfer result. $>
  .read INCLUDE_IF(OS_WINDOWS)
    COROUTINE(@CONTROLLER AUTO(controller_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
    ENABLE_IF(IS_FUNCTUM_CALLABLE_WITH(file_transfer_runtime, @controller MUT& controller_type))
  {
    VAR transfer positioned_file_transfer#(@writing FALSE, @controller_type controller_type)
      :(@controller CONTROLLER, @descriptor .descriptor, @buffer buffer, @offset offset);
    result := AWAIT(transfer.pending);
  }

  DOC <$ Submits a positioned write to the selected I/O runtime and stores the completed transfer result. $>
  .write INCLUDE_IF(OS_WINDOWS)
    COROUTINE(@CONTROLLER AUTO(controller_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
    ENABLE_IF(IS_FUNCTUM_CALLABLE_WITH(file_transfer_runtime, @controller MUT& controller_type))
  {
    VAR transfer positioned_file_transfer#(@writing TRUE, @controller_type controller_type)
      :(@controller CONTROLLER, @descriptor .descriptor, @buffer buffer, @offset offset);
    result := AWAIT(transfer.pending);
  }

  DOC <$ Awaits a positioned read on the async_runtime of the calling coroutine and stores the completed transfer result. $>
  .read INCLUDE_IF(OS_LINUX || OS_MACOS)
    COROUTINE(@CONTROLLER async_controller#AUTO(result_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
  {
    result := AWAIT(CONTROLLER.runtime->.read(@descriptor .descriptor, @buffer buffer, @offset offset));
  }

  DOC <$ Awaits a positioned write on the async_runtime of the calling coroutine and stores the completed transfer result. $>
  .write INCLUDE_IF(OS_LINUX || OS_MACOS)
    COROUTINE(@CONTROLLER async_controller#AUTO(result_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
  {
    result := AWAIT(CONTROLLER.runtime->.write(@descriptor .descriptor, @buffer buffer, @offset offset));
  }

  DOC <$ Awaits a positioned read operation in the calling coroutine's frame on its async_runtime2 and stores the completed transfer result. $>
  .read INCLUDE_IF(OS_MACOS)
    COROUTINE(@CONTROLLER async_controller2#AUTO(result_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
  {
    VAR operation kqueue_file_read :(@runtime CONTROLLER.io_runtime(), @descriptor .descriptor, @buffer buffer, @offset offset);
    result := AWAIT(operation);
  }

  DOC <$ Awaits a positioned read operation in the calling coroutine's frame on its async_runtime2 and stores the completed transfer result. The operation type matches the mechanism that the runtime selected for the running kernel. $>
  .read INCLUDE_IF(OS_LINUX)
    COROUTINE(@CONTROLLER async_controller2#AUTO(result_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
  {
    IF (CONTROLLER.io_runtime().uses_io_uring())
    {
      VAR ring_operation io_uring_file_read :(@runtime CONTROLLER.io_runtime(), @descriptor .descriptor, @buffer buffer, @offset offset);
      result := AWAIT(ring_operation);
    }
    ELSE
    {
      VAR worker_operation epoll_file_read :(@runtime CONTROLLER.io_runtime(), @descriptor .descriptor, @buffer buffer, @offset offset);
      result := AWAIT(worker_operation);
    }
  }

  DOC <$ Awaits a positioned write operation in the calling coroutine's frame on its async_runtime2 and stores the completed transfer result. $>
  .write INCLUDE_IF(OS_MACOS)
    COROUTINE(@CONTROLLER async_controller2#AUTO(result_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
  {
    VAR operation kqueue_file_write :(@runtime CONTROLLER.io_runtime(), @descriptor .descriptor, @buffer buffer, @offset offset);
    result := AWAIT(operation);
  }

  DOC <$ Awaits a positioned write operation in the calling coroutine's frame on its async_runtime2 and stores the completed transfer result. The operation type matches the mechanism that the runtime selected for the running kernel. $>
  .write INCLUDE_IF(OS_LINUX)
    COROUTINE(@CONTROLLER async_controller2#AUTO(result_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
  {
    IF (CONTROLLER.io_runtime().uses_io_uring())
    {
      VAR ring_operation io_uring_file_write :(@runtime CONTROLLER.io_runtime(), @descriptor .descriptor, @buffer buffer, @offset offset);
      result := AWAIT(ring_operation);
    }
    ELSE
    {
      VAR worker_operation epoll_file_write :(@runtime CONTROLLER.io_runtime(), @descriptor .descriptor, @buffer buffer, @offset offset);
      result := AWAIT(worker_operation);
    }
  }

  DOC <$ Schedules a cursor read on the selected I/O runtime and stores the completed transfer result. $>
  .read
    COROUTINE(@CONTROLLER AUTO(controller_type), @buffer CONST& buffer_ref, @result WRITE& transfer_result)
    ENABLE_IF(IS_FUNCTUM_CALLABLE_WITH(file_transfer_runtime, @controller MUT& controller_type))
  {
    result := AWAIT(file_transfer_runtime(@controller CONTROLLER).read(@descriptor .descriptor, @buffer buffer));
  }

  DOC <$ Schedules a cursor write on the selected I/O runtime and stores the completed transfer result. $>
  .write
    COROUTINE(@CONTROLLER AUTO(controller_type), @buffer CONST& buffer_ref, @result WRITE& transfer_result)
    ENABLE_IF(IS_FUNCTUM_CALLABLE_WITH(file_transfer_runtime, @controller MUT& controller_type))
  {
    result := AWAIT(file_transfer_runtime(@controller CONTROLLER).write(@descriptor .descriptor, @buffer buffer));
  }
}

DOC <$
  A non-owning reference to an open Java random-access file. Destroying this
  value does not close the Java object.
  $>
::file_ref INCLUDE_IF(ARCH_IS_JVM)
  STRUCT
{
  .random_access_file VAR ~> java_random_access_file;

  DOC <$ Creates an empty file reference. $>
  .CONSTRUCTOR FUNCTION() { }

  DOC <$ Reports whether the reference contains a Java file object. $>
  .is_valid FUNCTION() CONST: BOOL { RETURN .random_access_file != NULL; }

  DOC <$ Creates a non-owning reference to random_access_file. $>
  .CONSTRUCTOR FUNCTION(@random_access_file ~> java_random_access_file)
  {
    .random_access_file := random_access_file;
  }

  DOC <$ Reads at most buffer.size bytes into buffer and stores the outcome in result. $>
  .read FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    outcome.succeeded := TRUE;
    LOOP WHILE (outcome.size < buffer.size) DO
    {
      VAR value I32 := jvm_random_access_file_read(@THIS .random_access_file);
      IF (value < 0)
      {
        result := outcome;
        RETURN;
      }
      buffer.data[outcome.size] := (value AS CHECKED U8) AS BYTE;
      outcome.size++;
    }
    result := outcome;
  }

  DOC <$ Writes buffer.size bytes from buffer and stores the outcome in result. $>
  .write FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    VAR outcome transfer_result;
    LOOP WHILE (outcome.size < buffer.size) DO
    {
      VAR value BYTE := buffer.data[outcome.size];
      jvm_random_access_file_write(
        @THIS .random_access_file,
        @value ((value AS U8) AS ASSUME I32)
      );
      outcome.size++;
    }
    outcome.succeeded := TRUE;
    result := outcome;
  }

  DOC <$ Returns the current file length in bytes. $>
  .size FUNCTION(): SZ
  {
    VAR length I64 := jvm_random_access_file_length(
      @THIS .random_access_file
    );
    RETURN length AS CHECKED SZ;
  }

  DOC <$ Truncates the file to zero bytes. $>
  .truncate FUNCTION()
  {
    jvm_random_access_file_set_length(
      @THIS .random_access_file,
      @length 0
    );
  }

  DOC <$ Closes the referenced Java random-access file. $>
  .close FUNCTION(): BOOL
  {
    jvm_random_access_file_close(@THIS .random_access_file);
    RETURN TRUE;
  }
}

DOC <$
  Limits one Windows transfer to the DWORD count accepted by ReadFile and
  WriteFile. Callers can continue with the untransferred suffix.
  $>
::windows_transfer_size INCLUDE_IF(OS_WINDOWS)
  FUNCTION(@size SZ): U32
{
  VAR maximum U32 := (0 AS U32) #!!;
  IF (size > maximum AS SZ)
  {
    RETURN maximum;
  }
  RETURN size AS ASSUME U32;
}

DOC <$
  An automatic resource management object with exclusive ownership of a file_ref. Default construction creates a closed
  owner. Construction from a valid file_ref transfers exclusive ownership;
  the caller retains no responsibility for closing the native resource.
  Moving releases the source. Destruction closes a valid owned reference once.
  $>
::file STRUCT MOVE_ONLY
{
  PRIVATE(CLASS)
  {
    .native_ref VAR file_ref;
  }

  DOC <$ Creates a closed owner. $>
  .CONSTRUCTOR FUNCTION() { }

  DOC <$ Takes exclusive ownership of native_ref. Empty references remain closed. $>
  .CONSTRUCTOR FUNCTION(@native_ref AUTO& file_ref) :> .native_ref:(@OTHER FORWARD(native_ref)) {}

  DOC <$ Transfers ownership from OTHER and leaves OTHER closed. $>
  .CONSTRUCTOR FUNCTION(@OTHER TEMP& file)
  {
    .native_ref := OTHER.release();
  }

  DOC <$ Closes the current resource and transfers ownership from OTHER. Self-move preserves ownership. $>
  .OPERATOR:= FUNCTION(@OTHER TEMP& file) MUT
  {
    VAR incoming file_ref := OTHER.release();
    .close();
    .native_ref := MOVE(incoming);
  }

  DOC <$ Closes the owned reference if it is valid. $>
  .DESTRUCTOR FUNCTION() { .close(); }

  DOC <$ Borrows the owned reference without transferring responsibility for closing it. $>
  .reference FUNCTION() CONST: file_ref
  {
    RETURN .native_ref;
  }

  DOC <$ Reports whether this value owns a valid native reference. $>
  .is_open FUNCTION() CONST: BOOL
  {
    RETURN .native_ref.is_valid();
  }

  DOC <$ Transfers responsibility for closing the reference to the caller and leaves this owner closed. $>
  .release FUNCTION() MUT: file_ref
  {
    VAR previous file_ref;
    previous <-> .native_ref;
    RETURN previous;
  }

  DOC <$ Reads into buffer through the owned reference. Closed owners report an unsuccessful transfer. $>
  .read FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    IF (.is_open())
    {
      .native_ref.read(@buffer buffer, @result result);
      RETURN;
    }
    VAR outcome transfer_result;
    result := outcome;
  }

  DOC <$ Writes buffer through the owned reference. Closed owners report an unsuccessful transfer. $>
  .write FUNCTION(@buffer CONST& buffer_ref, @result WRITE& transfer_result)
  {
    IF (.is_open())
    {
      .native_ref.write(@buffer buffer, @result result);
      RETURN;
    }
    VAR outcome transfer_result;
    result := outcome;
  }

  DOC <$ Relinquishes ownership before closing the native reference. Closed owners succeed without a native call; failed closes are not retried. $>
  .close FUNCTION(): BOOL
  {
    IF (.is_open() == FALSE) { RETURN TRUE; }
    VAR previous file_ref := .release();
    RETURN previous.close();
  }

  DOC <$ Submits a positioned read to the selected I/O runtime and stores the completed transfer result. $>
  .read INCLUDE_IF(OS_WINDOWS)
    COROUTINE(@CONTROLLER AUTO(controller_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
    ENABLE_IF(IS_FUNCTUM_CALLABLE_WITH(file_transfer_runtime, @controller MUT& controller_type))
  {
    VAR transfer positioned_file_transfer#(@writing FALSE, @controller_type controller_type)
      :(@controller CONTROLLER, @descriptor .native_ref.descriptor, @buffer buffer, @offset offset);
    result := AWAIT(transfer.pending);
  }

  DOC <$ Submits a positioned write to the selected I/O runtime and stores the completed transfer result. $>
  .write INCLUDE_IF(OS_WINDOWS)
    COROUTINE(@CONTROLLER AUTO(controller_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
    ENABLE_IF(IS_FUNCTUM_CALLABLE_WITH(file_transfer_runtime, @controller MUT& controller_type))
  {
    VAR transfer positioned_file_transfer#(@writing TRUE, @controller_type controller_type)
      :(@controller CONTROLLER, @descriptor .native_ref.descriptor, @buffer buffer, @offset offset);
    result := AWAIT(transfer.pending);
  }

  DOC <$ Awaits a positioned read on the async_runtime of the calling coroutine and stores the completed transfer result. $>
  .read INCLUDE_IF(OS_LINUX || OS_MACOS)
    COROUTINE(@CONTROLLER async_controller#AUTO(result_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
  {
    result := AWAIT(CONTROLLER.runtime->.read(@descriptor .native_ref.descriptor, @buffer buffer, @offset offset));
  }

  DOC <$ Awaits a positioned write on the async_runtime of the calling coroutine and stores the completed transfer result. $>
  .write INCLUDE_IF(OS_LINUX || OS_MACOS)
    COROUTINE(@CONTROLLER async_controller#AUTO(result_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
  {
    result := AWAIT(CONTROLLER.runtime->.write(@descriptor .native_ref.descriptor, @buffer buffer, @offset offset));
  }

  DOC <$ Awaits a positioned read operation in the calling coroutine's frame on its async_runtime2 and stores the completed transfer result. $>
  .read INCLUDE_IF(OS_MACOS)
    COROUTINE(@CONTROLLER async_controller2#AUTO(result_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
  {
    VAR operation kqueue_file_read :(@runtime CONTROLLER.io_runtime(), @descriptor .native_ref.descriptor, @buffer buffer, @offset offset);
    result := AWAIT(operation);
  }

  DOC <$ Awaits a positioned read operation in the calling coroutine's frame on its async_runtime2 and stores the completed transfer result. The operation type matches the mechanism that the runtime selected for the running kernel. $>
  .read INCLUDE_IF(OS_LINUX)
    COROUTINE(@CONTROLLER async_controller2#AUTO(result_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
  {
    IF (CONTROLLER.io_runtime().uses_io_uring())
    {
      VAR ring_operation io_uring_file_read :(@runtime CONTROLLER.io_runtime(), @descriptor .native_ref.descriptor, @buffer buffer, @offset offset);
      result := AWAIT(ring_operation);
    }
    ELSE
    {
      VAR worker_operation epoll_file_read :(@runtime CONTROLLER.io_runtime(), @descriptor .native_ref.descriptor, @buffer buffer, @offset offset);
      result := AWAIT(worker_operation);
    }
  }

  DOC <$ Awaits a positioned write operation in the calling coroutine's frame on its async_runtime2 and stores the completed transfer result. $>
  .write INCLUDE_IF(OS_MACOS)
    COROUTINE(@CONTROLLER async_controller2#AUTO(result_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
  {
    VAR operation kqueue_file_write :(@runtime CONTROLLER.io_runtime(), @descriptor .native_ref.descriptor, @buffer buffer, @offset offset);
    result := AWAIT(operation);
  }

  DOC <$ Awaits a positioned write operation in the calling coroutine's frame on its async_runtime2 and stores the completed transfer result. The operation type matches the mechanism that the runtime selected for the running kernel. $>
  .write INCLUDE_IF(OS_LINUX)
    COROUTINE(@CONTROLLER async_controller2#AUTO(result_type), @buffer CONST& buffer_ref, @offset U64, @result WRITE& transfer_result)
  {
    IF (CONTROLLER.io_runtime().uses_io_uring())
    {
      VAR ring_operation io_uring_file_write :(@runtime CONTROLLER.io_runtime(), @descriptor .native_ref.descriptor, @buffer buffer, @offset offset);
      result := AWAIT(ring_operation);
    }
    ELSE
    {
      VAR worker_operation epoll_file_write :(@runtime CONTROLLER.io_runtime(), @descriptor .native_ref.descriptor, @buffer buffer, @offset offset);
      result := AWAIT(worker_operation);
    }
  }

  DOC <$ Schedules a cursor read on the selected I/O runtime and stores the completed transfer result. $>
  .read INCLUDE_IF(OS_LINUX || OS_MACOS || OS_WINDOWS)
    COROUTINE(@CONTROLLER AUTO(controller_type), @buffer CONST& buffer_ref, @result WRITE& transfer_result)
    ENABLE_IF(IS_FUNCTUM_CALLABLE_WITH(file_transfer_runtime, @controller MUT& controller_type))
  {
    result := AWAIT(file_transfer_runtime(@controller CONTROLLER).read(@descriptor .native_ref.descriptor, @buffer buffer));
  }

  DOC <$ Schedules a cursor write on the selected I/O runtime and stores the completed transfer result. $>
  .write INCLUDE_IF(OS_LINUX || OS_MACOS || OS_WINDOWS)
    COROUTINE(@CONTROLLER AUTO(controller_type), @buffer CONST& buffer_ref, @result WRITE& transfer_result)
    ENABLE_IF(IS_FUNCTUM_CALLABLE_WITH(file_transfer_runtime, @controller MUT& controller_type))
  {
    result := AWAIT(file_transfer_runtime(@controller CONTROLLER).write(@descriptor .native_ref.descriptor, @buffer buffer));
  }

}

PRIVATE(MODULE)
{
  ::posix_filesystem INCLUDE_IF(OS_LINUX) ALIAS syscall::linux;
  ::posix_filesystem INCLUDE_IF(OS_MACOS) ALIAS syscall::macos;

  DOC <$
    Opens a null-terminated copy of path with flags and transfers the descriptor
    to an owning file. Embedded null bytes and open failures throw an I32 value.
    Creation permissions are read/write for all users, restricted by the process umask.
    $>
  ::open_posix INCLUDE_IF(OS_LINUX || OS_MACOS)
    FUNCTION(@path CONST& std::string, @flags posix_filesystem::open_flags): file
  {
    VAR native_path std::dynarr#BYTE;
    LOOP VALUE(index) FROM(0 AS SZ) UNTIL(path.size()) DO
    {
      VAR character BYTE := path[index];
      IF (character == 0) { THROW (-1 AS I32); }
      native_path.push_back(character);
    }
    native_path.push_back(0);
    VAR address ADDRESS := IBC_GETADDR(@PTR native_path[0]<-);
    VAR bytes CONST=>>BYTE := IBC_PUN#(CONST=>>BYTE)(@ADDR address);
    VAR descriptor I32 := posix_filesystem::open(
      @path bytes,
      @flags flags #|| posix_filesystem::open_flags::cloexec,
      @mode posix_filesystem::file_mode::rusr #|| posix_filesystem::file_mode::wusr
        #|| posix_filesystem::file_mode::rgrp #|| posix_filesystem::file_mode::wgrp
        #|| posix_filesystem::file_mode::roth #|| posix_filesystem::file_mode::woth
    );
    IF (descriptor < 0) { THROW descriptor; }
    RETURN file(@native_ref file_ref(@descriptor io_descriptor_ref(@native_handle descriptor)));
  }
}

DOC <$
  Opens an existing path for reading and returns its owner. Embedded null bytes
  and open failures throw an I32 value. The file is closed during unwinding.
  $>
::open_read INCLUDE_IF(OS_LINUX || OS_MACOS)
  FUNCTION(@path CONST& std::string): file
{
  RETURN open_posix(@path path, @flags posix_filesystem::rdonly);
}

DOC <$
  Opens path for reading and writing, creating it when absent, and returns its
  owner. Existing contents are preserved. Embedded null bytes and open failures
  throw an I32 value. Creation permissions are restricted by the process umask.
  $>
::open_read_write INCLUDE_IF(OS_LINUX || OS_MACOS)
  FUNCTION(@path CONST& std::string): file
{
  RETURN open_posix(@path path,
    @flags posix_filesystem::open_flags::rdwr #|| posix_filesystem::open_flags::creat);
}

DOC <$
  Opens path for reading and writing, creating it when absent and truncating
  existing contents, and returns its owner. Embedded null bytes and open failures
  throw an I32 value. Creation permissions are restricted by the process umask.
  $>
::open_replace INCLUDE_IF(OS_LINUX || OS_MACOS)
  FUNCTION(@path CONST& std::string): file
{
  RETURN open_posix(@path path,
    @flags posix_filesystem::open_flags::rdwr #|| posix_filesystem::open_flags::creat
      #|| posix_filesystem::open_flags::trunc);
}

DOC <$
  Opens path for Java random-access reading and writing and returns its owner.
  Java I/O exceptions propagate out of the generated JVM program.
  $>
::open_read_write INCLUDE_IF(ARCH_IS_JVM)
  FUNCTION(@path CONST& std::string): file
{
  VAR java_path ~> RUNTIME_MODULE::java_string :=
    std::java_string_from_string(@value path);
  VAR mode std::string := "rw";
  VAR java_mode ~> RUNTIME_MODULE::java_string :=
    std::java_string_from_string(@value mode);
  VAR random_access_file ~> java_random_access_file :=
    jvm_random_access_file_constructor(@path java_path, @mode java_mode);
  RETURN file(
    @native_ref file_ref(@random_access_file random_access_file)
  );
}

DOC <$
  Opens path for Java random-access reading and returns its owner.
  Java I/O exceptions propagate out of the generated JVM program.
  $>
::open_read INCLUDE_IF(ARCH_IS_JVM)
  FUNCTION(@path CONST& std::string): file
{
  VAR java_path ~> RUNTIME_MODULE::java_string :=
    std::java_string_from_string(@value path);
  VAR mode std::string := "r";
  VAR java_mode ~> RUNTIME_MODULE::java_string :=
    std::java_string_from_string(@value mode);
  VAR random_access_file ~> java_random_access_file :=
    jvm_random_access_file_constructor(@path java_path, @mode java_mode);
  RETURN file(
    @native_ref file_ref(@random_access_file random_access_file)
  );
}

DOC <$
  Opens path for Java random-access reading and writing, truncates it, and
  returns its owner. Java I/O exceptions propagate out of the generated JVM
  program.
  $>
::open_replace INCLUDE_IF(ARCH_IS_JVM)
  FUNCTION(@path CONST& std::string): file
{
  VAR java_path ~> RUNTIME_MODULE::java_string :=
    std::java_string_from_string(@value path);
  VAR mode std::string := "rw";
  VAR java_mode ~> RUNTIME_MODULE::java_string :=
    std::java_string_from_string(@value mode);
  VAR random_access_file ~> java_random_access_file :=
    jvm_random_access_file_constructor(@path java_path, @mode java_mode);
  VAR reference file_ref := file_ref(
    @random_access_file random_access_file
  );
  reference.truncate();
  RETURN file(@native_ref reference);
}

DOC <$
  Creates an empty temporary file, schedules deletion when the JVM exits, and
  returns its path.
  $>
::create_temporary_path INCLUDE_IF(ARCH_IS_JVM)
  FUNCTION(): std::string
{
  VAR prefix std::string := "quxlang-cortado-";
  VAR suffix std::string := ".tmp";
  VAR java_prefix ~> RUNTIME_MODULE::java_string :=
    std::java_string_from_string(@value prefix);
  VAR java_suffix ~> RUNTIME_MODULE::java_string :=
    std::java_string_from_string(@value suffix);
  VAR temporary_file ~> java_file := jvm_file_create_temp_file(
    @prefix java_prefix,
    @suffix java_suffix
  );
  jvm_file_delete_on_exit(@THIS temporary_file);
  VAR java_path ~> RUNTIME_MODULE::java_string :=
    jvm_file_get_path(@THIS temporary_file);
  RETURN std::string_from_java_string(@value java_path);
}
