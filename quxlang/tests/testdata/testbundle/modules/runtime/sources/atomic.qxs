LANGUAGE QUXLANG EN 0.0;

DOC <$ Serializes atomic accesses wider than the target's native atomic width. $>
PRIVATE(MODULE) ::non_native_atomic_lock VAR ATOMIC#U32;

DOC <$ Acquires the runtime lock for a non-native atomic operation. $>
PRIVATE(MODULE) ::non_native_atomic_acquire FUNCTION() NOEXCEPT
{
  RUNTIME CONSTEXPR { RETURN; }
  ELSE
  {
    LOOP WHILE (non_native_atomic_lock.EXCHANGE#ATOMIC_SEQCST(1) != 0) DO { }
  }
}

DOC <$ Releases the runtime lock after a non-native atomic operation. $>
PRIVATE(MODULE) ::non_native_atomic_release FUNCTION() NOEXCEPT
{
  RUNTIME CONSTEXPR { RETURN; }
  ELSE { non_native_atomic_lock.STORE#ATOMIC_SEQCST(0); }
}

DOC <$ Loads a payload under the runtime's non-native atomic lock. $>
::ATOMIC_LOAD TEMPLATE(@T TYPE AUTO)
FUNCTION(@THIS:target CONST& ATOMIC#T) NOEXCEPT: T
{
  non_native_atomic_acquire();
  DEFER { non_native_atomic_release(); }
  RETURN target.LOAD#NONATOMIC();
}

DOC <$ Stores a payload under the runtime's non-native atomic lock. $>
::ATOMIC_STORE TEMPLATE(@T TYPE AUTO)
FUNCTION(@THIS:target MUT& ATOMIC#T, @ARG:value T) NOEXCEPT
{
  non_native_atomic_acquire();
  DEFER { non_native_atomic_release(); }
  target.STORE#NONATOMIC(value);
}

DOC <$ Replaces a payload under the runtime's non-native atomic lock. $>
::ATOMIC_EXCHANGE TEMPLATE(@T TYPE AUTO)
FUNCTION(@THIS:target MUT& ATOMIC#T, @ARG:value T) NOEXCEPT: T
{
  non_native_atomic_acquire();
  DEFER { non_native_atomic_release(); }
  RETURN target.EXCHANGE#NONATOMIC(value);
}

DOC <$ Compares and conditionally replaces a payload under the runtime's non-native atomic lock. $>
::ATOMIC_COMPARE_EXCHANGE TEMPLATE(@T TYPE AUTO)
FUNCTION(@THIS:target MUT& ATOMIC#T, @EXPECTED:expected MUT& T, @DESIRED:desired T) NOEXCEPT: BOOL
{
  non_native_atomic_acquire();
  DEFER { non_native_atomic_release(); }
  RETURN target.COMPARE_EXCHANGE#(@SUCCESS NONATOMIC, @FAILURE NONATOMIC)(@EXPECTED expected, @DESIRED desired);
}

