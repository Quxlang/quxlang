LANGUAGE QUXLANG EN 0.0;

::PROGRAM_START INCLUDE_IF(OS_LINUX) ASM_PROCEDURE X64
{
  MOV RDI, RSP
  MOVABS RAX, OFFSET PROCEDURE_REF("", linux_parse_initial_stack!$[0])
  CALL RAX
  MOVABS RAX, OFFSET PROCEDURE_REF("", linux_initial_tls_start!$[0])
  CALL RAX
  CALL DETECT_CPU_ARCHINFO
  CALL PICK_STEPPING
  MOV R10, RAX
  MOVABS RAX, OFFSET OBJECT_REF(ACTIVE_STEPPING)
  MOV [RAX], R10
  MOVABS RAX, OFFSET OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  MOV RAX, [RAX]
  MOV RAX, [RAX + R10 * 8]
  CALL RAX
  MOV RDI, 127
  MOV RAX, 60
  SYSCALL
}

::PROGRAM_START INCLUDE_IF(OS_LINUX) ASM_PROCEDURE X86
{
  MOV ECX, ESP
  PUSH ECX
  MOV EAX, OFFSET PROCEDURE_REF("", linux_parse_initial_stack!$[0])
  CALL EAX
  ADD ESP, 4
  MOV EAX, OFFSET PROCEDURE_REF("", linux_initial_tls_start!$[0])
  CALL EAX
  CALL DETECT_CPU_ARCHINFO
  CALL PICK_STEPPING
  MOV ECX, EAX
  MOV EAX, OFFSET OBJECT_REF(ACTIVE_STEPPING)
  MOV [EAX], ECX
  MOV EAX, OFFSET OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  MOV EAX, [EAX]
  MOV EAX, [EAX + ECX * 4]
  CALL EAX
  MOV EBX, 127
  MOV EAX, 1
  INT 0x80
}

::PROGRAM_START INCLUDE_IF(OS_LINUX) ASM_PROCEDURE ARM64
{
  MOV X0, SP
  LDR X16, PROCEDURE_REF("", linux_parse_initial_stack!$[0])
  BLR X16
  LDR X16, PROCEDURE_REF("", linux_initial_tls_start!$[0])
  BLR X16
  BL DETECT_CPU_ARCHINFO
  BL PICK_STEPPING
  MOV X19, X0
  ADRP X16, :got:OBJECT_REF(ACTIVE_STEPPING)
  LDR X16, [X16, :got_lo12:OBJECT_REF(ACTIVE_STEPPING)]
  STR X19, [X16]
  ADRP X16, :got:OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  LDR X16, [X16, :got_lo12:OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)]
  LDR X16, [X16]
  LDR X16, [X16, X19, LSL 3]
  BLR X16
  MOV X0, 127
  MOV X8, 93
  SVC 0
}

::PROGRAM_START INCLUDE_IF(OS_LINUX) ASM_PROCEDURE Z_ARCH
{
  LGR %r2, %r15
  AGHI %r15, -160
  BRASL %r14, PROCEDURE_REF("", linux_parse_initial_stack!$[0])
  BRASL %r14, PROCEDURE_REF("", linux_initial_tls_start!$[0])
  BRASL %r14, DETECT_CPU_ARCHINFO
  BRASL %r14, PICK_STEPPING
  LARL %r1, OBJECT_REF(ACTIVE_STEPPING)
  STG %r2, 0(%r1)
  LARL %r1, OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  LG %r1, 0(%r1)
  MGHI %r2, 8
  AGR %r2, %r1
  LG %r1, 0(%r2)
  BASR %r14, %r1
  LGHI %r2, 127
  LGHI %r1, 1
  SVC 0
}

DOC <$ Initializes Linux ARM EABI process state and invokes the selected stepping. $>
::PROGRAM_START INCLUDE_IF(OS_LINUX) ASM_PROCEDURE ARM32
{
  MOV R0, SP
  LDR R12, PROCEDURE_REF("", linux_parse_initial_stack!$[0])
  BLX R12
  LDR R12, PROCEDURE_REF("", linux_initial_tls_start!$[0])
  BLX R12
  BL DETECT_CPU_ARCHINFO
  BL PICK_STEPPING
  MOV R4, R0
  LDR R12, OBJECT_REF(ACTIVE_STEPPING)
  STR R4, [R12]
  LDR R12, OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  LDR R12, [R12]
  LDR R12, [R12, R4, LSL #2]
  BLX R12
  MOV R0, 127
  MOV R7, 1
  SVC 0
}

DOC <$ Initializes Linux RISC-V process state and invokes the selected stepping. $>
::PROGRAM_START INCLUDE_IF(OS_LINUX) ASM_PROCEDURE RISCV32
{
  MV a0, sp
  ANDI sp, sp, -16
  CALL PROCEDURE_REF("", linux_parse_initial_stack!$[0])
  CALL PROCEDURE_REF("", linux_initial_tls_start!$[0])
  CALL DETECT_CPU_ARCHINFO
  CALL PICK_STEPPING
  MV s0, a0
  LA t0, OBJECT_REF(ACTIVE_STEPPING)
  SW s0, 0(t0)
  LA t0, OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  LW t0, 0(t0)
  SLLI t1, s0, 2
  ADD t0, t0, t1
  LW t0, 0(t0)
  JALR ra, t0, 0
  LI a0, 127
  LI a7, 93
  ECALL
  UNIMP
}

DOC <$ Initializes Linux RISC-V process state and invokes the selected stepping. $>
::PROGRAM_START INCLUDE_IF(OS_LINUX) ASM_PROCEDURE RISCV64
{
  MV a0, sp
  ANDI sp, sp, -16
  CALL PROCEDURE_REF("", linux_parse_initial_stack!$[0])
  CALL PROCEDURE_REF("", linux_initial_tls_start!$[0])
  CALL DETECT_CPU_ARCHINFO
  CALL PICK_STEPPING
  MV s0, a0
  LA t0, OBJECT_REF(ACTIVE_STEPPING)
  SD s0, 0(t0)
  LA t0, OBJECT_REF(POST_DETECT_FUNCTION_ARRAY)
  LD t0, 0(t0)
  SLLI t1, s0, 3
  ADD t0, t0, t1
  LD t0, 0(t0)
  JALR ra, t0, 0
  LI a0, 127
  LI a7, 93
  ECALL
  UNIMP
}
