LANGUAGE QUXLANG EN 0.0;

IMPORT syscall;

DOC <$
  Matches the target's native atomic integer width: 64 bits on 64-bit targets
  and 32 bits on 32-bit targets, using the target-sized unsigned integer type.
  $>
PRIVATE(MODULE) ::layer3_bitmap_word ALIAS UINTPTR;
PRIVATE(MODULE) ::layer3_bitmap_word_bits STATIC SZ := SIZEOF(layer3_bitmap_word) * 8;

PRIVATE(MODULE) ::layer3_region_exclusive STATIC U32 := 2147483648;
PRIVATE(MODULE) ::layer3_region_requested STATIC U32 := 1073741824;
PRIVATE(MODULE) ::layer3_region_readers STATIC U32 := 1073741823;

DOC <$
  Retains stable identity after backing retirement. Region access requires shared
  or exclusive ownership. Intrusive links require the allocation-class mutex.
  The complete 32-bit semaphore is supported by every native address-wait API.
  $>
PRIVATE(MODULE) ::layer3_region_control STRUCT
{
  .semaphore VAR ATOMIC#U32;
  .region VAR MUT->layer3_region;
  .next VAR MUT->layer3_region_control;
  .prev VAR MUT->layer3_region_control;

  DOC <$ Acquires one shared region use without waiting. $>
  .try_shared FUNCTION(): BOOL
  {
    VAR observed U32 := .semaphore.LOAD#ATOMIC_RELAXED();
    LOOP WHILE ((observed #&& layer3_region_exclusive) == 0
      && (observed #&& layer3_region_readers) != layer3_region_readers) DO
    {
      IF (.semaphore.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_ACQUIRE, @FAILURE ATOMIC_RELAXED)(@EXPECTED observed, @DESIRED observed + 1))
      { RETURN TRUE; }
    }
    RETURN FALSE;
  }

  DOC <$ Acquires shared access, registering notification before sleeping. $>
  .shared FUNCTION()
  {
    LOOP WHILE (.try_shared() == FALSE) DO
    {
      VAR observed U32 := .semaphore.LOAD#ATOMIC_RELAXED();
      LOOP WHILE ((observed #&& layer3_region_exclusive) != 0) DO
      {
        VAR requested U32 := observed #|| layer3_region_requested;
        IF (observed == requested || .semaphore.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_RELAXED, @FAILURE ATOMIC_RELAXED)(@EXPECTED observed, @DESIRED requested))
        {
          wait_at_u32_address(@address IBC_GETADDR(@PTR .semaphore<-), @expected requested);
          BREAK;
        }
      }
    }
  }

  DOC <$ Completes all region accesses before dropping the reader count. $>
  .release_shared FUNCTION()
  { .semaphore.FETCH_SUBTRACT#ATOMIC_RELEASE(1); }

  DOC <$ Requests exclusive ownership and drains existing readers. $>
  .try_exclusive FUNCTION(): BOOL
  {
    VAR observed U32 := .semaphore.LOAD#ATOMIC_RELAXED();
    LOOP WHILE ((observed #&& layer3_region_exclusive) == 0) DO
    {
      IF (.semaphore.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_ACQUIRE, @FAILURE ATOMIC_RELAXED)(@EXPECTED observed, @DESIRED observed #|| layer3_region_exclusive))
      {
        LOOP WHILE ((.semaphore.LOAD#ATOMIC_ACQUIRE() #&& layer3_region_readers) != 0) DO { yield_thread_execution(); }
        RETURN TRUE;
      }
    }
    RETURN FALSE;
  }

  DOC <$ Clears ownership and fulfills registered notification obligations. $>
  .release_exclusive FUNCTION()
  {
    VAR observed U32 := .semaphore.LOAD#ATOMIC_RELAXED();
    LOOP WHILE (.semaphore.COMPARE_EXCHANGE#(@SUCCESS ATOMIC_RELEASE, @FAILURE ATOMIC_RELAXED)(@EXPECTED observed, @DESIRED 0) == FALSE) DO { }
    IF ((observed #&& layer3_region_requested) != 0)
    { notify_all_at_address(@address IBC_GETADDR(@PTR .semaphore<-), @size SIZEOF(U32)); }
  }

  DOC <$ Removes a published control under its class mutex. $>
  .unlink FUNCTION()
  {
    .prev->.next := .next;
    .next->.prev := .prev;
  }
}

DOC <$
  Stores metadata before aligned payload slots. Set bitmap bits include all
  pointers cached in plates and all live application allocations. Unused bits
  stay clear and are excluded from fullness checks.
  $>
PRIVATE(MODULE) ::layer3_region STRUCT
{
  .control VAR MUT->layer3_region_control;
  .class_control VAR MUT->layer3_region_class;
  .available VAR ATOMIC#U32;
  .bitmap VAR [allocator_region_bitmap_word_count]ATOMIC#layer3_bitmap_word;
  .backing VAR MUT->layer4_backing_extent;
  .next_free VAR MUT->layer3_region;
}

DOC <$
  Owns circular available, fully issued, and detached control lists. Layout is
  initialized under the mutex before first publication and remains immutable.
  $>
PRIVATE(MODULE) ::layer3_region_class STRUCT
{
  .mtx VAR mutex;
  .available VAR layer3_region_control;
  .issued VAR layer3_region_control;
  .detached VAR layer3_region_control;
  .transfer_home VAR SZ;
  .block_size VAR SZ;
  .payload_offset VAR SZ;
  .slot_count VAR SZ;

  DOC <$ Establishes sentinel links and immutable slot geometry once. $>
  .initialize FUNCTION(@size SZ, @align SZ)
  {
    IF (.block_size != 0) { RETURN; }
    .available.next := .available<-;
    .available.prev := .available<-;
    .issued.next := .issued<-;
    .issued.prev := .issued<-;
    .detached.next := .detached<-;
    .detached.prev := .detached<-;
    .block_size := size;
    .payload_offset := ((SIZEOF(layer3_region) + align - 1) / align) * align;
    .slot_count := (allocator_slab_region_size - .payload_offset) / size;
  }
}

DOC <$ Inserts a control before a circular-list position under its mutex. $>
PRIVATE(MODULE) ::layer3_region_insert FUNCTION(@node MUT->layer3_region_control, @before MUT->layer3_region_control)
{
  node->.next := before;
  node->.prev := before->.prev;
  before->.prev->.next := node;
  before->.prev := node;
}

DOC <$ Identifies the pool list that currently contains an extent. $>
PRIVATE(MODULE) ::layer4_extent_membership IBC_ENUM BITS(8) [
  unlisted DEFAULT = 0,
  partial = 1,
  retained = 2,
  purged = 3
];

DOC <$
  The extent describes one aligned backing mapping divided into allocation regions.
  Regions that have never been issued are claimed from the unissued inventory.
  Regions returned while other regions of the extent remain issued form an
  intrusive free list. An extent without issued regions discards its free list
  and restores its complete unissued inventory. The idle epoch records the pool
  epoch at which the extent joined the retained or purged list. The pool mutex
  protects every field.
  $>
PRIVATE(MODULE) ::layer4_backing_extent STRUCT
{
  .mapping VAR ADDRESS;
  .mapping_bytes VAR SZ;
  .first VAR ADDRESS;
  .region_count VAR SZ;
  .next VAR ADDRESS;
  .unissued VAR SZ;
  .free VAR MUT->layer3_region;
  .issued VAR SZ;
  .list VAR layer4_extent_membership;
  .idle_epoch VAR SZ;
  .newer VAR MUT->layer4_backing_extent;
  .older VAR MUT->layer4_backing_extent;
}

DOC <$ The list orders extents by insertion time and records the payload bytes of its members. $>
PRIVATE(MODULE) ::layer4_extent_list STRUCT
{
  .newest VAR MUT->layer4_backing_extent;
  .oldest VAR MUT->layer4_backing_extent;
  .bytes VAR SZ;

  DOC <$ Inserts an unlisted extent as the newest member and records the list identity in the extent. $>
  .insert FUNCTION(@extent MUT->layer4_backing_extent, @kind layer4_extent_membership)
  {
    extent->.list := kind;
    extent->.newer := NULL;
    extent->.older := .newest;
    IF (.newest??) { .newest->.newer := extent; }
    ELSE { .oldest := extent; }
    .newest := extent;
    .bytes += extent->.region_count * allocator_slab_region_size;
  }

  DOC <$ Removes a member from any position in the list. $>
  .remove FUNCTION(@extent MUT->layer4_backing_extent)
  {
    IF (extent->.newer??) { extent->.newer->.older := extent->.older; }
    ELSE { .newest := extent->.older; }
    IF (extent->.older??) { extent->.older->.newer := extent->.newer; }
    ELSE { .oldest := extent->.newer; }
    extent->.newer := NULL;
    extent->.older := NULL;
    extent->.list := layer4_extent_membership::unlisted;
    .bytes -= extent->.region_count * allocator_slab_region_size;
  }
}

DOC <$
  The pool retains every mapped extent that can supply a region. The partial list
  contains extents with both issued and obtainable regions. The retained list
  contains extents without issued regions whose pages remain resident. The purged
  list contains extents without issued regions whose pages have been offered to
  the operating system while the mapping remains valid. The epoch counts
  completed collection passes and orders the idle time of listed extents.
  $>
PRIVATE(MODULE) ::layer4_region_pool STRUCT
{
  .mtx VAR mutex;
  .partial VAR layer4_extent_list;
  .retained VAR layer4_extent_list;
  .purged VAR layer4_extent_list;
  .issued_count VAR SZ;
  .epoch VAR SZ;
}
PRIVATE(MODULE) ::layer4_region_backing VAR layer4_region_pool;

DOC <$ The promotion count scales large-span use to one two-hundred-and-fifty-sixth of physical memory, with a sixteen-MiB fallback. $>
PRIVATE(MODULE) ::layer4_extent_promotion_count FUNCTION(@memory_bytes U64): SZ
{
  VAR bytes U64 := memory_bytes / 256;
  IF (memory_bytes == 0) { bytes := 16777216; }
  VAR count U64 := bytes / (allocator_slab_region_size AS U64);
  IF (count == 0) { RETURN 1; }
  VAR limit SZ := ((0 AS SZ) #!!) / 2;
  IF (count > (limit AS U64)) { RETURN limit; }
  STATIC_IF(CELLSIZEOF(SZ) == CELLSIZEOF(U64)) { RETURN count AS SZ; }
  STATIC_ELSE { RETURN count AS PARTIAL SZ; }
}

DOC <$ The span function promotes growing heaps to larger mappings while small heaps retain fine-grained backing. $>
PRIVATE(MODULE) ::layer4_extent_span FUNCTION(@issued_count SZ, @memory_bytes U64): SZ
{
  VAR span SZ := allocator_slab_region_size;
  IF (issued_count >= layer4_extent_promotion_count(@memory_bytes memory_bytes)
    && span < 2097152) { span := 2097152; }
  RETURN span;
}

DOC <$ The creator maps an aligned region inventory with the selected backing span. Separate metadata avoids faulting an otherwise unused huge page in the alignment padding and survives a purge of the backing pages. $>
PRIVATE(MODULE) ::layer4_extent_create FUNCTION(@span SZ): MUT->layer4_backing_extent
{
  VAR bytes SZ := span * 2;
  VAR mapping ADDRESS := layer5_map_region(@bytes bytes);
  IF (mapping!?) { RETURN NULL; }
  VAR metadata ADDRESS := layer5_map_region(@bytes allocator_page_size);
  IF (metadata!?) { layer5_unmap_region(@address mapping, @bytes bytes); RETURN NULL; }
  VAR storage MUT->TYPED_STORAGE(layer4_backing_extent) := ADDRESS_LAUNDER_DISCOVER_EXISTING metadata
    TO MUT->TYPED_STORAGE(layer4_backing_extent);
  VAR extent MUT->layer4_backing_extent := PLACE AT(storage->) layer4_backing_extent;
  extent->.mapping := mapping;
  extent->.mapping_bytes := bytes;
  VAR start ADDRESS := mapping;
  IF (start % span != 0) { start := start + (span - (start % span)); }
  extent->.first := start;
  extent->.region_count := span / allocator_slab_region_size;
  extent->.next := start;
  extent->.unissued := extent->.region_count;
  RETURN extent;
}

DOC <$ The unmap function releases the backing and metadata mappings of an unlisted extent without issued regions. $>
PRIVATE(MODULE) ::layer4_extent_unmap FUNCTION(@extent MUT->layer4_backing_extent)
{
  VAR bytes SZ := extent->.mapping_bytes;
  VAR mapping ADDRESS := extent->.mapping;
  layer5_unmap_region(@address mapping, @bytes bytes);
  layer5_unmap_region(@address IBC_GETADDR(@PTR extent), @bytes allocator_page_size);
}

DOC <$
  The acquisition function claims one region from the newest partial, retained, or
  purged extent, in that order of preference, and maps a new extent only when no
  mapped extent can supply a region. Mapping occurs outside the pool lock.
  $>
PRIVATE(MODULE) ::layer4_region_acquire FUNCTION(): MUT->layer3_region
{
  allocator_process_start();
  layer4_region_backing.mtx.lock();
  VAR extent MUT->layer4_backing_extent := layer4_region_backing.partial.newest;
  IF (extent??) { layer4_region_backing.partial.remove(@extent extent); }
  ELSE
  {
    extent := layer4_region_backing.retained.newest;
    IF (extent??) { layer4_region_backing.retained.remove(@extent extent); }
    ELSE
    {
      extent := layer4_region_backing.purged.newest;
      IF (extent??) { layer4_region_backing.purged.remove(@extent extent); }
    }
  }
  IF (extent!?)
  {
    VAR span SZ := layer4_extent_span(@issued_count layer4_region_backing.issued_count,
      @memory_bytes allocator_host_memory_bytes);
    layer4_region_backing.mtx.unlock();
    extent := layer4_extent_create(@span span);
    IF (extent!? && span > allocator_slab_region_size)
    { extent := layer4_extent_create(@span allocator_slab_region_size); }
    IF (extent!?) { RETURN NULL; }
    layer4_region_backing.mtx.lock();
  }
  VAR result MUT->layer3_region := extent->.free;
  VAR address ADDRESS;
  IF (result??) { extent->.free := result->.next_free; }
  ELSE
  {
    address := extent->.next;
    extent->.next := extent->.next + allocator_slab_region_size;
    extent->.unissued--;
  }
  extent->.issued++;
  layer4_region_backing.issued_count++;
  IF ((extent->.free??) || extent->.unissued > 0)
  { layer4_region_backing.partial.insert(@extent extent, @kind layer4_extent_membership::partial); }
  layer4_region_backing.mtx.unlock();
  IF (result!?)
  {
    // The issued region keeps the extent mapped while the region object is constructed outside the lock.
    VAR storage MUT->TYPED_STORAGE(layer3_region) := ADDRESS_LAUNDER_DISCOVER_EXISTING address TO MUT->TYPED_STORAGE(layer3_region);
    result := PLACE AT(storage->) layer3_region;
    result->.backing := extent;
  }
  RETURN result;
}

DOC <$
  The release function returns one region to its extent. An extent without issued
  regions joins the retained list, and the collector is started or resumed when
  the pool holds enough idle bytes. The collector purges and unmaps idle extents
  asynchronously. The byte limits remain synchronous bounds: retained bytes above
  the retention limit are purged oldest first, and purged bytes above the purge
  limit are unmapped oldest first. Purging and unmapping occur outside the pool
  lock on unlisted extents.
  $>
PRIVATE(MODULE) ::layer4_region_release FUNCTION(@region MUT->layer3_region)
{
  allocator_process_start();
  VAR extent MUT->layer4_backing_extent := region->.backing;
  layer4_region_backing.mtx.lock();
  layer4_region_backing.issued_count--;
  extent->.issued--;
  IF (extent->.issued > 0)
  {
    region->.next_free := extent->.free;
    extent->.free := region;
    IF (extent->.list == layer4_extent_membership::unlisted)
    { layer4_region_backing.partial.insert(@extent extent, @kind layer4_extent_membership::partial); }
    layer4_region_backing.mtx.unlock();
    RETURN;
  }
  IF (extent->.list == layer4_extent_membership::partial) { layer4_region_backing.partial.remove(@extent extent); }
  extent->.free := NULL;
  extent->.next := extent->.first;
  extent->.unissued := extent->.region_count;
  extent->.idle_epoch := layer4_region_backing.epoch;
  layer4_region_backing.retained.insert(@extent extent, @kind layer4_extent_membership::retained);
  LOOP WHILE (layer4_region_backing.retained.bytes > allocator_retained_region_bytes_limit) DO
  {
    VAR victim MUT->layer4_backing_extent := layer4_region_backing.retained.oldest;
    layer4_region_backing.retained.remove(@extent victim);
    layer4_region_backing.mtx.unlock();
    layer5_purge_region(@address victim->.first, @bytes victim->.region_count * allocator_slab_region_size);
    layer4_region_backing.mtx.lock();
    victim->.idle_epoch := layer4_region_backing.epoch;
    layer4_region_backing.purged.insert(@extent victim, @kind layer4_extent_membership::purged);
  }
  LOOP WHILE (layer4_region_backing.purged.bytes > allocator_purged_region_bytes_limit) DO
  {
    VAR victim MUT->layer4_backing_extent := layer4_region_backing.purged.oldest;
    layer4_region_backing.purged.remove(@extent victim);
    layer4_region_backing.mtx.unlock();
    layer4_extent_unmap(@extent victim);
    layer4_region_backing.mtx.lock();
  }
  VAR request layer4_collector_request := layer4_collector_request_locked(@pool layer4_region_backing);
  layer4_region_backing.mtx.unlock();
  layer4_collector_fulfill(@request request);
}

DOC <$ Allocates a stable chunk of controls and publishes them on the detached list, returning false on allocation failure. $>
PRIVATE(MODULE) ::layer3_region_controls FUNCTION(@root MUT& layer3_region_class): BOOL
{
  VAR mapping ADDRESS := layer5_map_region(@bytes allocator_slab_region_size);
  IF (mapping!?) { RETURN FALSE; }
  VAR count SZ := allocator_slab_region_size / CELLSIZEOF(layer3_region_control);
  // Construction precedes publication; mapping and initialization occur outside the list lock.
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(count) DO
  {
    VAR storage MUT->TYPED_STORAGE(layer3_region_control) := ADDRESS_LAUNDER_DISCOVER_EXISTING
      (mapping + index * CELLSIZEOF(layer3_region_control)) TO MUT->TYPED_STORAGE(layer3_region_control);
    PLACE AT(storage->) layer3_region_control;
  }
  root.mtx.lock();
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(count) DO
  {
    VAR node MUT->layer3_region_control := ADDRESS_LAUNDER_DISCOVER_EXISTING
      (mapping + index * CELLSIZEOF(layer3_region_control)) TO MUT->layer3_region_control;
    layer3_region_insert(@node node, @before root.detached<-);
  }
  root.mtx.unlock();
  RETURN TRUE;
}

DOC <$ Checks whether every payload slot has been returned while region access is held. $>
PRIVATE(MODULE) ::layer3_region_empty FUNCTION(@region MUT->layer3_region): BOOL
{
  VAR words SZ := (region->.class_control->.slot_count + layer3_bitmap_word_bits - 1) / layer3_bitmap_word_bits;
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL(words) DO
  { IF (region->.bitmap[index].LOAD#ATOMIC_ACQUIRE() != 0) { RETURN FALSE; } }
  RETURN TRUE;
}

DOC <$ Checks every valid slot while region access is held. $>
PRIVATE(MODULE) ::layer3_region_full FUNCTION(@region MUT->layer3_region): BOOL
{
  VAR slots SZ := region->.class_control->.slot_count;
  LOOP VALUE(index) FROM(0 AS SZ) UNTIL((slots + layer3_bitmap_word_bits - 1) / layer3_bitmap_word_bits) DO
  {
    VAR mask layer3_bitmap_word := (0 AS layer3_bitmap_word) #!!;
    IF (slots - index * layer3_bitmap_word_bits < layer3_bitmap_word_bits) { mask := ((1 AS layer3_bitmap_word) #++ (slots - index * layer3_bitmap_word_bits)) - 1; }
    IF (region->.bitmap[index].LOAD#ATOMIC_ACQUIRE() != mask) { RETURN FALSE; }
  }
  RETURN TRUE;
}

DOC <$ Detaches empty backing under exclusive access before returning it to the shared pool. $>
PRIVATE(MODULE) ::layer3_region_retire FUNCTION(@control MUT->layer3_region_control)
{
  IF (control->.try_exclusive() == FALSE) { RETURN; }
  VAR region MUT->layer3_region := control->.region;
  IF (region?? && layer3_region_empty(@region region))
  {
    VAR root MUT->layer3_region_class := region->.class_control;
    root->.mtx.lock();
    region->.available.STORE#ATOMIC_RELEASE(0);
    VAR no_region MUT->layer3_region;
    control->.region := no_region;
    control->.unlink();
    layer3_region_insert(@node control, @before root->.detached<-);
    root->.mtx.unlock();
    layer4_region_release(@region region);
  }
  control->.release_exclusive();
}

DOC <$
  The return function consumes the final run of same-region addresses without requiring slot
  order within the run. One shared region access protects mask aggregation and all bitmap updates.
  Availability publication and retirement checks occur once for the run. A nonzero block size
  template argument must equal the block size of every region in the cache and converts slot
  index computation into constant division; a zero argument selects the region's recorded size.
  $>
PRIVATE(MODULE) ::layer3_region_return_batch TEMPLATE(@count VALUE SZ, @block_size VALUE SZ)
  FUNCTION(@cache MUT& addr_cache#(@count count))
{
  ASSERT(cache.used > 0, "A region return batch requires at least one address.");
  VAR address ADDRESS := PUN cache.entries[cache.used - 1] AS ADDRESS;
  VAR base ADDRESS := address - (address % allocator_slab_region_size);
  VAR region MUT->layer3_region := ADDRESS_LAUNDER_DISCOVER_EXISTING base TO MUT->layer3_region;
  VAR control MUT->layer3_region_control := region->.control;
  control->.shared();
  VAR root MUT->layer3_region_class := region->.class_control;
  VAR masks [allocator_region_bitmap_word_count]layer3_bitmap_word;
  VAR first_word SZ := allocator_region_bitmap_word_count;
  VAR last_word SZ := 0;
  VAR payload_offset SZ := root->.payload_offset;
  VAR remaining SZ := cache.used;
  // Consecutive addresses usually share a bitmap word. The mask of the current word is accumulated
  // in a local variable and stored once per word change, so the loop carries no dependency through
  // the mask array.
  VAR run_word SZ := allocator_region_bitmap_word_count;
  VAR run_mask layer3_bitmap_word := 0;
  LOOP WHILE (remaining > 0) DO
  {
    address := PUN cache.entries[remaining - 1] AS ADDRESS;
    IF (address - (address % allocator_slab_region_size) != base) { BREAK; }
    VAR index SZ;
    STATIC_IF(block_size == 0) { index := ((address - base) - payload_offset) / root->.block_size; }
    STATIC_ELSE { index := ((address - base) - payload_offset) / block_size; }
    VAR word SZ := index / layer3_bitmap_word_bits;
    VAR bit layer3_bitmap_word := (1 AS layer3_bitmap_word) #++ (index % layer3_bitmap_word_bits);
    IF (word != run_word)
    {
      IF (run_mask != 0) { masks[run_word] := masks[run_word] #|| run_mask; }
      run_word := word;
      run_mask := 0;
      IF (word < first_word) { first_word := word; }
      IF (word > last_word) { last_word := word; }
    }
    ASSERT(((masks[word] #|| run_mask) #&& bit) == 0, "A region return batch contains a duplicate slot.");
    run_mask := run_mask #|| bit;
    remaining--;
    DESTROY AT(cache.entries[remaining]) ADDRESS;
  }
  IF (run_mask != 0) { masks[run_word] := masks[run_word] #|| run_mask; }
  cache.used := remaining;
  LOOP VALUE(word) FROM(first_word) UNTIL(last_word + 1) DO
  {
    VAR mask layer3_bitmap_word := masks[word];
    IF (mask != 0)
    {
      VAR previous layer3_bitmap_word := region->.bitmap[word].FETCH_BIT_AND#ATOMIC_RELEASE(mask #!!);
      ASSERT((previous #&& mask) == mask, "A region slot was returned twice.");
    }
  }
  IF (region->.available.LOAD#ATOMIC_ACQUIRE() == 0)
  {
    root->.mtx.lock();
    IF (region->.available.LOAD#ATOMIC_RELAXED() == 0)
    {
      control->.unlink();
      layer3_region_insert(@node control, @before root->.available.next);
      region->.available.STORE#ATOMIC_RELEASE(1);
    }
    root->.mtx.unlock();
  }
  VAR empty BOOL := layer3_region_empty(@region region);
  control->.release_shared();
  IF (empty) { layer3_region_retire(@control control); }
}

DOC <$
  The plate return function returns a privately owned plate to its allocation regions, one run of
  same-region addresses per batch, with one atomic update per occupied bitmap word. A plate
  whose addresses change region more than once per sixteen entries is grouped by region first;
  a plate that is already mostly grouped is returned in its existing order. The empty plate
  remains owned by the caller. A zero block size selects the block size recorded by each region.
  $>
PRIVATE(MODULE) ::layer3_region_return_plate TEMPLATE(@count VALUE SZ, @block_size VALUE SZ)
  FUNCTION(@cache MUT& addr_cache#(@count count))
{
  IF (cache.region_changes_exceed(@limit (count / 16) + 1)) { cache.group_regions(); }
  LOOP WHILE (cache.used > 0) DO { layer3_region_return_batch#(@count count, @block_size block_size)(@cache cache); }
}

DOC <$
  Returns a single slot through the region batch protocol during uncached deallocation.
  $>
PRIVATE(MODULE) ::layer3_region_return FUNCTION(@address ADDRESS)
{
  VAR cache addr_cache#(@count 1);
  cache.push(address);
  layer3_region_return_batch#(@count 1, @block_size 0)(@cache cache);
}

DOC <$
  Claims slots into a privately owned plate. List selection never retains the
  list mutex while acquiring region access, scanning bitmaps, or mapping memory.
  A failed refill returns false and leaves any claimed slots owned by the cache.
  $>
PRIVATE(MODULE) ::layer3_region_refill TEMPLATE(@count VALUE SZ)
  FUNCTION(@root MUT& layer3_region_class, @cache MUT& addr_cache#(@count count)): BOOL
{
  LOOP WHILE (cache.used < count) DO
  {
    root.mtx.lock();
    VAR control MUT->layer3_region_control := root.available.next;
    VAR busy BOOL := control != root.available<-;
    LOOP WHILE (control != root.available<- &&
      ((control->.semaphore.LOAD#ATOMIC_RELAXED() #&& layer3_region_exclusive) != 0
      || (control->.semaphore.LOAD#ATOMIC_RELAXED() #&& layer3_region_readers) == layer3_region_readers)) DO
    { control := control->.next; }
    IF (control == root.available<-)
    {
      IF (busy) { root.mtx.unlock(); yield_thread_execution(); CONTINUE; }
      control := root.detached.next;
      IF (control == root.detached<-)
      {
        root.mtx.unlock();
        IF (layer3_region_controls(@root root) == FALSE) { RETURN FALSE; }
        CONTINUE;
      }
      root.mtx.unlock();
      IF (control->.try_exclusive() !!) {
        yield_thread_execution();
        CONTINUE;
      }
      IF (control->.region!?)
      {
        VAR region MUT->layer3_region := layer4_region_acquire();
        IF (region!?) { control->.release_exclusive(); RETURN FALSE; }
        region->.control := control;
        region->.class_control := root<-;
        LOOP VALUE(index) FROM(0 AS SZ) UNTIL(allocator_region_bitmap_word_count) DO
        { region->.bitmap[index].STORE#ATOMIC_RELAXED(0); }
        region->.available.STORE#ATOMIC_RELAXED(0);
        root.mtx.lock();
        control->.region := region;
        control->.unlink();
        layer3_region_insert(@node control, @before root.available.next);
        region->.available.STORE#ATOMIC_RELEASE(1);
        root.mtx.unlock();
      }
      control->.release_exclusive();
      CONTINUE;
    }
    root.mtx.unlock();
    IF (control->.try_shared() == FALSE) { yield_thread_execution(); CONTINUE; }
    VAR region MUT->layer3_region := control->.region;
    IF ((region??) == FALSE) { control->.release_shared(); CONTINUE; }
    VAR initial_count SZ := cache.used;
    VAR base ADDRESS := IBC_GETADDR(@PTR region);
    LOOP VALUE(word) FROM(0 AS SZ) UNTIL((root.slot_count + layer3_bitmap_word_bits - 1) / layer3_bitmap_word_bits) DO
    {
      VAR valid layer3_bitmap_word := (0 AS layer3_bitmap_word) #!!;
      IF (root.slot_count - word * layer3_bitmap_word_bits < layer3_bitmap_word_bits)
      { valid := ((1 AS layer3_bitmap_word) #++ (root.slot_count - word * layer3_bitmap_word_bits)) - 1; }
      VAR observed layer3_bitmap_word := region->.bitmap[word].LOAD#ATOMIC_RELAXED();
      LOOP WHILE (cache.used < count && (observed #&& valid) != valid) DO
      {
        VAR clear layer3_bitmap_word := (observed #!!) #&& valid;
        VAR selected layer3_bitmap_word := 0;
        VAR selected_count SZ := 0;
        VAR remaining SZ := count - cache.used;
        // A plate with room for a complete word claims every clear slot without per-bit selection.
        IF (remaining >= layer3_bitmap_word_bits) { selected := clear; }
        ELSE
        {
          LOOP WHILE (clear != 0 && selected_count < remaining) DO
          {
            VAR bit layer3_bitmap_word := clear #&& ((clear #!!) + 1);
            selected := selected #|| bit;
            clear := clear #^^ bit;
            selected_count++;
          }
        }
        IF (region->.bitmap[word].COMPARE_EXCHANGE#(@SUCCESS ATOMIC_ACQREL, @FAILURE ATOMIC_RELAXED)(@EXPECTED observed, @DESIRED observed #|| selected))
        {
          observed := observed #|| selected;
          // The slot address advances by one block per bit, and the plate length is stored once per word.
          VAR slot_size SZ := root.block_size;
          VAR slot ADDRESS := base + root.payload_offset + (word * layer3_bitmap_word_bits) * slot_size;
          VAR used SZ := cache.used;
          LOOP WHILE (selected != 0) DO
          {
            IF ((selected #&& 1) != 0)
            {
              PLACE AT(cache.entries[used]) ADDRESS := slot;
              used++;
            }
            selected := selected #-- 1;
            slot := slot + slot_size;
          }
          cache.used := used;
        }
      }
      IF (cache.used == count) { BREAK; }
    }
    IF (cache.used == initial_count)
    {
      root.mtx.lock();
      IF (region->.available.LOAD#ATOMIC_RELAXED() != 0)
      { control->.unlink(); layer3_region_insert(@node control, @before root.available<-); }
      root.mtx.unlock();
    }
    control->.release_shared();
    // An exhausted scan can fill part of the plate while consuming the region.
    IF (cache.used < count && control->.try_exclusive())
    {
      region := control->.region;
      IF (region?? && layer3_region_full(@region region))
      {
        root.mtx.lock();
        control->.unlink();
        layer3_region_insert(@node control, @before root.issued<-);
        region->.available.STORE#ATOMIC_RELEASE(0);
        root.mtx.unlock();
      }
      control->.release_exclusive();
    }
  }
  RETURN TRUE;
}
