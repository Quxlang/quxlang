    @launch MUT->static_linux_thread_launch;
    RETURN I32
  )
{
  LI a7, 220
  ECALL
  BNEZ a0, clone_parent
  MV a0, a5
  CALL PROCEDURE_REF("", static_linux_thread_worker!$[0])
  LI a0, 0
  LI a7, 93
