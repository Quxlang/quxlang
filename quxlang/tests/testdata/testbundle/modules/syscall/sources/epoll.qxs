  DOC <$ Creates an anonymous memory-backed file. $>
  ::memfd_create ASM_PROCEDURE X64
    CALLABLE CALLCONV CCALL(@name CONST=>>BYTE, @flags U32; RETURN I32)
  {
    MOV RAX, 319
    SYSCALL
    RET
  }

  DOC <$ Creates an anonymous memory-backed file. $>
  ::memfd_create ASM_PROCEDURE X86
    CALLABLE CALLCONV CCALL(@name CONST=>>BYTE, @flags U32; RETURN I32)
  {
    PUSH EBX
    MOV EBX, [ESP+8]
    MOV ECX, [ESP+12]
    MOV EAX, 356
    INT 0x80
    POP EBX
    RET
  }

  DOC <$ Creates an anonymous memory-backed file. $>
  ::memfd_create ASM_PROCEDURE ARM32
    CALLABLE CALLCONV CCALL(@name CONST=>>BYTE, @flags U32; RETURN I32)
  {
    SUB SP, SP, 8
    STR R7, [SP, 0]
    MOVW R7, 385
    SVC 0
    LDR R7, [SP, 0]
    ADD SP, SP, 8
    BX LR
  }

  DOC <$ Creates an anonymous memory-backed file. $>
  ::memfd_create ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@name CONST=>>BYTE, @flags U32; RETURN I32)
  {
    MOV X8, 279
    SVC 0
    RET
  }

