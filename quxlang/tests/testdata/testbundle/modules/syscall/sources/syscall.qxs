LANGUAGE QUXLANG EN 0.0;


::linux INCLUDE_IF(OS_LINUX) NAMESPACE
{
  ::open_flags FLAGSET BITS(32) [
    wronly = 1,
    rdwr = 2,
    creat = 64,
    excl = 128,
    noctty = 256,
    trunc = 512,
    append = 1024,
    nonblock = 2048,
    directory = 65536,
    cloexec = 524288
  ];
  ::rdonly STATIC open_flags := (0 AS U32) AS open_flags;

  ::prot_flags FLAGSET BITS(32) [
    read = 1,
    write = 2,
    exec = 4
  ];
  ::none STATIC prot_flags := (0 AS U32) AS prot_flags;

  ::mmap_flags FLAGSET BITS(32) [
    shared = 1,
    private = 2,
    fixed = 16,
    anonymous = 32
  ];

  DOC <$ Selects the treatment that the madvise system call requests for a page range. $>
  ::memory_advice IBC_ENUM BITS(32) [
    discard_immediately = 4,
    release_lazily = 8
  ];

  ::seek_whence IBC_ENUM [
    set = 0,
    cur = 1,
    end = 2
  ];

  ::file_mode FLAGSET BITS(32) [
    rusr = 256,
    wusr = 128,
    xusr = 64,
    rgrp = 32,
    wgrp = 16,
    xgrp = 8,
    roth = 4,
    woth = 2,
    xoth = 1
  ];

  ::write ASM_PROCEDURE X64
    CALLABLE CALLCONV CCALL(@fd I32, @buffer CONST =>> BYTE, @count SZ; RETURN SZ)
  {
    MOV RAX, 1
    SYSCALL
    RET
  }

  ::write ASM_PROCEDURE X86
    CALLABLE CALLCONV CCALL(@fd I32, @buffer CONST =>> BYTE, @count SZ; RETURN SZ)
  {
    PUSH EBX
    MOV EBX, [ESP+8]
    MOV ECX, [ESP+12]
    MOV EDX, [ESP+16]
    MOV EAX, 4
    INT 0x80
    POP EBX
    RET
  }

  DOC <$ Invokes the Linux ARM EABI write system call. $>
  ::write ASM_PROCEDURE ARM32
    CALLABLE CALLCONV CCALL(@fd I32, @buffer CONST =>> BYTE, @count SZ; RETURN SZ)
  {
    SUB SP, SP, 8
    STR R7, [SP, 0]
    MOV R7, 4
    SVC 0
    LDR R7, [SP, 0]
    ADD SP, SP, 8
    BX LR
  }

  ::write ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@fd I32, @buffer CONST =>> BYTE, @count SZ; RETURN SZ)
  {
    MOV X8, 64
    SVC 0
    RET
  }

  DOC <$ Implements the Linux RISC-V write operation. $>
  ::write ASM_PROCEDURE RISCV32
    CALLABLE CALLCONV CCALL(@fd I32, @buffer CONST =>> BYTE, @count SZ; RETURN SZ)
  {
    LI a7, 64
    ECALL
    RET
  }

  DOC <$ Implements the Linux RISC-V write operation. $>
  ::write ASM_PROCEDURE RISCV64
    CALLABLE CALLCONV CCALL(@fd I32, @buffer CONST =>> BYTE, @count SZ; RETURN SZ)
  {
    LI a7, 64
    ECALL
    RET
  }

  ::write ASM_PROCEDURE Z_ARCH
    CALLABLE CALLCONV CCALL(@fd I32, @buffer CONST =>> BYTE, @count SZ; RETURN SZ)
  {
    LGHI %r1, 4
    SVC 0
    BR %r14
  }

  ::exit ASM_PROCEDURE X64
    CALLABLE(@code I32; RETURN I32)
  {
    MOV RAX, 60
    SYSCALL
    RET
  }

  ::exit ASM_PROCEDURE X86
    CALLABLE(@code I32; RETURN I32)
  {
    PUSH EBX
    MOV EBX, [ESP+8]
    MOV EAX, 1
    INT 0x80
    POP EBX
    RET
  }

  DOC <$ Invokes the Linux ARM EABI exit system call. $>
  ::exit ASM_PROCEDURE ARM32
    CALLABLE(@code I32; RETURN I32)
  {
    SUB SP, SP, 8
    STR R7, [SP, 0]
    MOV R7, 1
    SVC 0
    LDR R7, [SP, 0]
    ADD SP, SP, 8
    BX LR
  }

  ::exit ASM_PROCEDURE ARM64
    CALLABLE(@code I32; RETURN I32)
  {
    MOV X8, 93
    SVC 0
    RET
  }

  DOC <$ Implements the Linux RISC-V exit operation. $>
  ::exit ASM_PROCEDURE RISCV32
    CALLABLE(@code I32; RETURN I32)
  {
    LI a7, 93
    ECALL
    RET
  }

  DOC <$ Implements the Linux RISC-V exit operation. $>
  ::exit ASM_PROCEDURE RISCV64
    CALLABLE(@code I32; RETURN I32)
  {
    LI a7, 93
    ECALL
    RET
  }

  ::exit ASM_PROCEDURE Z_ARCH
    CALLABLE(@code I32; RETURN I32)
  {
    LGHI %r1, 1
    SVC 0
    BR %r14
  }

  ::exit_group ASM_PROCEDURE X64
    CALLABLE(@code I32; RETURN I32)
  {
    MOV RAX, 231
    SYSCALL
    RET
  }

  ::exit_group ASM_PROCEDURE X86
    CALLABLE(@code I32; RETURN I32)
  {
    PUSH EBX
    MOV EBX, [ESP+8]
    MOV EAX, 252
    INT 0x80
    POP EBX
    RET
  }

  DOC <$ Invokes the Linux ARM EABI exit_group system call. $>
  ::exit_group ASM_PROCEDURE ARM32
    CALLABLE(@code I32; RETURN I32)
  {
    SUB SP, SP, 8
    STR R7, [SP, 0]
    MOV R7, 248
    SVC 0
    LDR R7, [SP, 0]
    ADD SP, SP, 8
    BX LR
  }

  ::exit_group ASM_PROCEDURE ARM64
    CALLABLE(@code I32; RETURN I32)
  {
    MOV X8, 94
    SVC 0
    RET
  }

  DOC <$ Implements the Linux RISC-V exit group operation. $>
  ::exit_group ASM_PROCEDURE RISCV32
    CALLABLE(@code I32; RETURN I32)
  {
    LI a7, 94
    ECALL
    RET
  }

  DOC <$ Implements the Linux RISC-V exit group operation. $>
  ::exit_group ASM_PROCEDURE RISCV64
    CALLABLE(@code I32; RETURN I32)
  {
    LI a7, 94
    ECALL
    RET
  }

  ::exit_group ASM_PROCEDURE Z_ARCH
    CALLABLE(@code I32; RETURN I32)
  {
    LGHI %r1, 248
    SVC 0
    BR %r14
  }

  ::mmap_anonymous_private ASM_PROCEDURE X64
    CALLABLE CALLCONV CCALL(@size SZ; RETURN ADDRESS)
  {
    MOV RSI, RDI
    XOR RDI, RDI
    MOV RDX, 3
    MOV R10, 34
    MOV R8, -1
    XOR R9, R9
    MOV RAX, 9
    SYSCALL
    // Linux reports syscall failures as pointer-sized values in [-4095, -1].
    MOV RDX, -4095
    CMP RAX, RDX
    MOV RDX, 0
    CMOVAE RAX, RDX
    RET
  }

  ::mmap_anonymous_private ASM_PROCEDURE X86
    CALLABLE CALLCONV CCALL(@size SZ; RETURN ADDRESS)
  {
    PUSH EBX
    PUSH ESI
    PUSH EDI
    PUSH EBP
    MOV ECX, [ESP+20]
    XOR EBX, EBX
    MOV EDX, 3
    MOV ESI, 34
    MOV EDI, -1
    XOR EBP, EBP
    MOV EAX, 192
    INT 0x80
    // Linux reports syscall failures as pointer-sized values in [-4095, -1].
    MOV EDX, -4095
    CMP EAX, EDX
    MOV EDX, 0
    CMOVAE EAX, EDX
    POP EBP
    POP EDI
    POP ESI
    POP EBX
    RET
  }

  DOC <$ Invokes the Linux ARM EABI mmap_anonymous_private system call. $>
  ::mmap_anonymous_private ASM_PROCEDURE ARM32
    CALLABLE CALLCONV CCALL(@size SZ; RETURN ADDRESS)
  {
    SUB SP, SP, 16
    STR R4, [SP, 0]
    STR R5, [SP, 4]
    STR R7, [SP, 8]
    MOV R1, R0
    MOV R0, 0
    MOV R2, 3
    MOV R3, 34
    MVN R4, 0
    MOV R5, 0
    MOV R7, 192
    SVC 0
    MOVW R1, 61441
    MOVT R1, 65535
    CMP R0, R1
    MOVHS R0, 0
    LDR R4, [SP, 0]
    LDR R5, [SP, 4]
    LDR R7, [SP, 8]
    ADD SP, SP, 16
    BX LR
  }

  ::mmap_anonymous_private ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@size SZ; RETURN ADDRESS)
  {
    MOV X1, X0
    MOV X0, 0
    MOV X2, 3
    MOV X3, 34
    MOV X4, -1
    MOV X5, 0
    MOV X8, 222
    SVC 0
    // Linux reports syscall failures as pointer-sized values in [-4095, -1].
    MOV X1, -4095
    CMP X0, X1
    CSEL X0, XZR, X0, HS
    RET
  }

  DOC <$ Implements the Linux RISC-V mmap anonymous private operation. $>
  ::mmap_anonymous_private ASM_PROCEDURE RISCV32
    CALLABLE CALLCONV CCALL(@size SZ; RETURN ADDRESS)
  {
    MV a1, a0
    LI a0, 0
    LI a2, 3
    LI a3, 34
    LI a4, -1
    LI a5, 0
    LI a7, 222
    ECALL
    LI t0, -4095
    BLTU a0, t0, mapping_ready
    LI a0, 0
    LABEL mapping_ready;
    RET
  }

  DOC <$ Implements the Linux RISC-V mmap anonymous private operation. $>
  ::mmap_anonymous_private ASM_PROCEDURE RISCV64
    CALLABLE CALLCONV CCALL(@size SZ; RETURN ADDRESS)
  {
    MV a1, a0
    LI a0, 0
    LI a2, 3
    LI a3, 34
    LI a4, -1
    LI a5, 0
    LI a7, 222
    ECALL
    LI t0, -4095
    BLTU a0, t0, mapping_ready
    LI a0, 0
    LABEL mapping_ready;
    RET
  }

  ::mmap_anonymous_private ASM_PROCEDURE Z_ARCH
    CALLABLE CALLCONV CCALL(@size SZ; RETURN ADDRESS)
  {
    AGHI %r15, -208
    MVGHI 160(%r15), 0
    STG %r2, 168(%r15)
    MVGHI 176(%r15), 3
    MVGHI 184(%r15), 34
    MVGHI 192(%r15), -1
    MVGHI 200(%r15), 0
    LA %r2, 160(%r15)
    LGHI %r1, 90
    SVC 0
    LGR %r3, %r2
    SRAG %r3, %r3, 63
    LGHI %r4, -1
    XGR %r3, %r4
    NGR %r2, %r3
    AGHI %r15, 208
    BR %r14
  }

  ::futex_wait ASM_PROCEDURE X64
    CALLABLE CALLCONV CCALL(@address ADDRESS, @expected I32; RETURN I32)
  {
    MOV RDX, RSI
    MOV RSI, 0
    XOR R10, R10
    XOR R8, R8
    XOR R9, R9
    MOV RAX, 202
    SYSCALL
    RET
  }

  ::futex_wait ASM_PROCEDURE X86
    CALLABLE CALLCONV CCALL(@address ADDRESS, @expected I32; RETURN I32)
  {
    PUSH EBX
    PUSH ESI
    PUSH EDI
    PUSH EBP
    MOV EBX, [ESP+20]
    MOV ECX, 0
    MOV EDX, [ESP+24]
    XOR ESI, ESI
    XOR EDI, EDI
    XOR EBP, EBP
    MOV EAX, 240
    INT 0x80
    POP EBP
    POP EDI
    POP ESI
    POP EBX
    RET
  }

  DOC <$ Invokes the Linux ARM EABI futex_wait system call. $>
  ::futex_wait ASM_PROCEDURE ARM32
    CALLABLE CALLCONV CCALL(@address ADDRESS, @expected I32; RETURN I32)
  {
    SUB SP, SP, 16
    STR R4, [SP, 0]
    STR R5, [SP, 4]
    STR R7, [SP, 8]
    MOV R2, R1
    MOV R1, 0
    MOV R3, 0
    MOV R4, 0
    MOV R5, 0
    MOV R7, 240
    SVC 0
    LDR R4, [SP, 0]
    LDR R5, [SP, 4]
    LDR R7, [SP, 8]
    ADD SP, SP, 16
    BX LR
  }

  ::futex_wait ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@address ADDRESS, @expected I32; RETURN I32)
  {
    MOV X2, X1
    MOV X1, 0
    MOV X3, 0
    MOV X4, 0
    MOV X5, 0
    MOV X8, 98
    SVC 0
    RET
  }

  DOC <$ Implements the Linux RISC-V futex wait operation. $>
  ::futex_wait ASM_PROCEDURE RISCV32
    CALLABLE CALLCONV CCALL(@address ADDRESS, @expected I32; RETURN I32)
  {
    MV a2, a1
    LI a1, 0
    LI a3, 0
    LI a4, 0
    LI a5, 0
    LI a7, 422
    ECALL
    RET
  }

  DOC <$ Implements the Linux RISC-V futex wait operation. $>
  ::futex_wait ASM_PROCEDURE RISCV64
    CALLABLE CALLCONV CCALL(@address ADDRESS, @expected I32; RETURN I32)
  {
    MV a2, a1
    LI a1, 0
    LI a3, 0
    LI a4, 0
    LI a5, 0
    LI a7, 98
    ECALL
    RET
  }

  ::futex_wait ASM_PROCEDURE Z_ARCH
    CALLABLE CALLCONV CCALL(@address ADDRESS, @expected I32; RETURN I32)
  {
    AGHI %r15, -16
    STG %r6, 0(%r15)
    STG %r7, 8(%r15)
    LGR %r4, %r3
    LGHI %r3, 0
    LGHI %r5, 0
    LGHI %r6, 0
    LGHI %r7, 0
    LGHI %r1, 238
    SVC 0
    LG %r6, 0(%r15)
    LG %r7, 8(%r15)
    AGHI %r15, 16
    BR %r14
  }

  ::futex_wake ASM_PROCEDURE X64
    CALLABLE CALLCONV CCALL(@address ADDRESS, @count I32; RETURN I32)
  {
    MOV RDX, RSI
    MOV RSI, 1
    XOR R10, R10
    XOR R8, R8
    XOR R9, R9
    MOV RAX, 202
    SYSCALL
    RET
  }

  ::futex_wake ASM_PROCEDURE X86
    CALLABLE CALLCONV CCALL(@address ADDRESS, @count I32; RETURN I32)
  {
    PUSH EBX
    PUSH ESI
    PUSH EDI
    PUSH EBP
    MOV EBX, [ESP+20]
    MOV ECX, 1
    MOV EDX, [ESP+24]
    XOR ESI, ESI
    XOR EDI, EDI
    XOR EBP, EBP
    MOV EAX, 240
    INT 0x80
    POP EBP
    POP EDI
    POP ESI
    POP EBX
    RET
  }

  DOC <$ Invokes the Linux ARM EABI futex_wake system call. $>
  ::futex_wake ASM_PROCEDURE ARM32
    CALLABLE CALLCONV CCALL(@address ADDRESS, @count I32; RETURN I32)
  {
    SUB SP, SP, 16
    STR R4, [SP, 0]
    STR R5, [SP, 4]
    STR R7, [SP, 8]
    MOV R2, R1
    MOV R1, 1
    MOV R3, 0
    MOV R4, 0
    MOV R5, 0
    MOV R7, 240
    SVC 0
    LDR R4, [SP, 0]
    LDR R5, [SP, 4]
    LDR R7, [SP, 8]
    ADD SP, SP, 16
    BX LR
  }

  ::futex_wake ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@address ADDRESS, @count I32; RETURN I32)
  {
    MOV X2, X1
    MOV X1, 1
    MOV X3, 0
    MOV X4, 0
    MOV X5, 0
    MOV X8, 98
    SVC 0
    RET
  }

  DOC <$ Implements the Linux RISC-V futex wake operation. $>
  ::futex_wake ASM_PROCEDURE RISCV32
    CALLABLE CALLCONV CCALL(@address ADDRESS, @count I32; RETURN I32)
  {
    MV a2, a1
    LI a1, 1
    LI a3, 0
    LI a4, 0
    LI a5, 0
    LI a7, 422
    ECALL
    RET
  }

  DOC <$ Implements the Linux RISC-V futex wake operation. $>
  ::futex_wake ASM_PROCEDURE RISCV64
    CALLABLE CALLCONV CCALL(@address ADDRESS, @count I32; RETURN I32)
  {
    MV a2, a1
    LI a1, 1
    LI a3, 0
    LI a4, 0
    LI a5, 0
    LI a7, 98
    ECALL
    RET
  }

  ::futex_wake ASM_PROCEDURE Z_ARCH
    CALLABLE CALLCONV CCALL(@address ADDRESS, @count I32; RETURN I32)
  {
    AGHI %r15, -16
    STG %r6, 0(%r15)
    STG %r7, 8(%r15)
    LGR %r4, %r3
    LGHI %r3, 1
    LGHI %r5, 0
    LGHI %r6, 0
    LGHI %r7, 0
    LGHI %r1, 238
    SVC 0
    LG %r6, 0(%r15)
    LG %r7, 8(%r15)
    AGHI %r15, 16
    BR %r14
  }

  ::read ASM_PROCEDURE X64
    CALLABLE CALLCONV CCALL(@fd I32, @buffer MUT =>> BYTE, @count SZ; RETURN SZ)
  {
    MOV RAX, 0
    SYSCALL
    RET
  }

  ::read ASM_PROCEDURE X86
    CALLABLE CALLCONV CCALL(@fd I32, @buffer MUT =>> BYTE, @count SZ; RETURN SZ)
  {
    PUSH EBX
    MOV EBX, [ESP+8]
    MOV ECX, [ESP+12]
    MOV EDX, [ESP+16]
    MOV EAX, 3
    INT 0x80
    POP EBX
    RET
  }

  DOC <$ Invokes the Linux ARM EABI read system call. $>
  ::read ASM_PROCEDURE ARM32
    CALLABLE CALLCONV CCALL(@fd I32, @buffer MUT =>> BYTE, @count SZ; RETURN SZ)
  {
    SUB SP, SP, 8
    STR R7, [SP, 0]
    MOV R7, 3
    SVC 0
    LDR R7, [SP, 0]
    ADD SP, SP, 8
    BX LR
  }

  ::read ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@fd I32, @buffer MUT =>> BYTE, @count SZ; RETURN SZ)
  {
    MOV X8, 63
    SVC 0
    RET
  }

  DOC <$ Implements the Linux RISC-V read operation. $>
  ::read ASM_PROCEDURE RISCV32
    CALLABLE CALLCONV CCALL(@fd I32, @buffer MUT =>> BYTE, @count SZ; RETURN SZ)
  {
    LI a7, 63
    ECALL
    RET
  }

  DOC <$ Implements the Linux RISC-V read operation. $>
  ::read ASM_PROCEDURE RISCV64
    CALLABLE CALLCONV CCALL(@fd I32, @buffer MUT =>> BYTE, @count SZ; RETURN SZ)
  {
    LI a7, 63
    ECALL
    RET
  }

  ::read ASM_PROCEDURE Z_ARCH
    CALLABLE CALLCONV CCALL(@fd I32, @buffer MUT =>> BYTE, @count SZ; RETURN SZ)
  {
    LGHI %r1, 3
    SVC 0
    BR %r14
  }

  ::close ASM_PROCEDURE X64
    CALLABLE CALLCONV CCALL(@fd I32; RETURN I32)
  {
    MOV RAX, 3
    SYSCALL
    RET
  }

  ::close ASM_PROCEDURE X86
    CALLABLE CALLCONV CCALL(@fd I32; RETURN I32)
  {
    PUSH EBX
    MOV EBX, [ESP+8]
    MOV EAX, 6
    INT 0x80
    POP EBX
    RET
  }

  DOC <$ Invokes the Linux ARM EABI close system call. $>
  ::close ASM_PROCEDURE ARM32
    CALLABLE CALLCONV CCALL(@fd I32; RETURN I32)
  {
    SUB SP, SP, 8
    STR R7, [SP, 0]
    MOV R7, 6
    SVC 0
    LDR R7, [SP, 0]
    ADD SP, SP, 8
    BX LR
  }

  ::close ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@fd I32; RETURN I32)
  {
    MOV X8, 57
    SVC 0
    RET
  }

  DOC <$ Implements the Linux RISC-V close operation. $>
  ::close ASM_PROCEDURE RISCV32
    CALLABLE CALLCONV CCALL(@fd I32; RETURN I32)
  {
    LI a7, 57
    ECALL
    RET
  }

  DOC <$ Implements the Linux RISC-V close operation. $>
  ::close ASM_PROCEDURE RISCV64
    CALLABLE CALLCONV CCALL(@fd I32; RETURN I32)
  {
    LI a7, 57
    ECALL
    RET
  }

  ::close ASM_PROCEDURE Z_ARCH
    CALLABLE CALLCONV CCALL(@fd I32; RETURN I32)
  {
    LGHI %r1, 6
    SVC 0
    BR %r14
  }

  ::open ASM_PROCEDURE X64
    CALLABLE CALLCONV CCALL(@path CONST =>> BYTE, @flags open_flags, @mode file_mode; RETURN I32)
  {
    MOV R10, RDX
    MOV RDX, RSI
    MOV RSI, RDI
    MOV RDI, -100 // AT_FDCWD
    MOV RAX, 257
    SYSCALL
    RET
  }

  ::open ASM_PROCEDURE X86
    CALLABLE CALLCONV CCALL(@path CONST =>> BYTE, @flags open_flags, @mode file_mode; RETURN I32)
  {
    PUSH EBX
    PUSH ESI
    MOV ECX, [ESP+12]
    MOV EDX, [ESP+16]
    MOV ESI, [ESP+20]
    MOV EBX, -100 // AT_FDCWD
    MOV EAX, 295
    INT 0x80
    POP ESI
    POP EBX
    RET
  }

  DOC <$ Invokes the Linux ARM EABI open system call. $>
  ::open ASM_PROCEDURE ARM32
    CALLABLE CALLCONV CCALL(@path CONST =>> BYTE, @flags open_flags, @mode file_mode; RETURN I32)
  {
    SUB SP, SP, 8
    STR R7, [SP, 0]
    MOV R7, 5
    SVC 0
    LDR R7, [SP, 0]
    ADD SP, SP, 8
    BX LR
  }

  ::open ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@path CONST =>> BYTE, @flags open_flags, @mode file_mode; RETURN I32)
  {
    MOV X3, X2
    MOV X2, X1
    MOV X1, X0
    MOV X0, -100 // AT_FDCWD
    MOV X8, 56
    SVC 0
    RET
  }

  DOC <$ Implements the Linux RISC-V open operation. $>
  ::open ASM_PROCEDURE RISCV32
    CALLABLE CALLCONV CCALL(@path CONST =>> BYTE, @flags open_flags, @mode file_mode; RETURN I32)
  {
    MV a3, a2
    MV a2, a1
    MV a1, a0
    LI a0, -100
    LI a7, 56
    ECALL
    RET
  }

  DOC <$ Implements the Linux RISC-V open operation. $>
  ::open ASM_PROCEDURE RISCV64
    CALLABLE CALLCONV CCALL(@path CONST =>> BYTE, @flags open_flags, @mode file_mode; RETURN I32)
  {
    MV a3, a2
    MV a2, a1
    MV a1, a0
    LI a0, -100
    LI a7, 56
    ECALL
    RET
  }

  ::open ASM_PROCEDURE Z_ARCH
    CALLABLE CALLCONV CCALL(@path CONST =>> BYTE, @flags open_flags, @mode file_mode; RETURN I32)
  {
    LGHI %r1, 5
    SVC 0
    BR %r14
  }

  ::lseek ASM_PROCEDURE X64
    CALLABLE CALLCONV CCALL(@fd I32, @offset SZ, @whence seek_whence; RETURN SZ)
  {
    MOV RAX, 8
    SYSCALL
    RET
  }

  ::lseek ASM_PROCEDURE X86
    CALLABLE CALLCONV CCALL(@fd I32, @offset SZ, @whence seek_whence; RETURN SZ)
  {
    PUSH EBX
    MOV EBX, [ESP+8]
    MOV ECX, [ESP+12]
    MOV EDX, [ESP+16]
    MOV EAX, 19
    INT 0x80
    POP EBX
    RET
  }

  DOC <$ Invokes the Linux ARM EABI lseek system call. $>
  ::lseek ASM_PROCEDURE ARM32
    CALLABLE CALLCONV CCALL(@fd I32, @offset SZ, @whence seek_whence; RETURN SZ)
  {
    SUB SP, SP, 8
    STR R7, [SP, 0]
    MOV R7, 19
    SVC 0
    LDR R7, [SP, 0]
    ADD SP, SP, 8
    BX LR
  }

  ::lseek ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@fd I32, @offset SZ, @whence seek_whence; RETURN SZ)
  {
    MOV X8, 62
    SVC 0
    RET
  }

  DOC <$ Implements the Linux RISC-V lseek operation. $>
  ::lseek ASM_PROCEDURE RISCV32
    CALLABLE CALLCONV CCALL(@fd I32, @offset SZ, @whence seek_whence; RETURN SZ)
  {
    MV a4, a2
    MV a2, a1
    LI a1, 0
    ADDI sp, sp, -16
    MV a3, sp
    LI a7, 62
    ECALL
    BLTZ a0, seek_done
    LW a0, 0(sp)
    LABEL seek_done;
    ADDI sp, sp, 16
    RET
  }

  DOC <$ Implements the Linux RISC-V lseek operation. $>
  ::lseek ASM_PROCEDURE RISCV64
    CALLABLE CALLCONV CCALL(@fd I32, @offset SZ, @whence seek_whence; RETURN SZ)
