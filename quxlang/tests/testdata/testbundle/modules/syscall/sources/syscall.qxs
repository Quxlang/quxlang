  ::mmap ASM_PROCEDURE X64
    CALLABLE CALLCONV CCALL(@addr ADDRESS, @len SZ, @prot prot_flags, @flags mmap_flags, @fd I32, @off SZ; RETURN ADDRESS)
  {
    MOV R10, RCX
    MOV RAX, 9
    SYSCALL
    RET
  }

  ::mmap ASM_PROCEDURE X86
    CALLABLE CALLCONV CCALL(@addr ADDRESS, @len SZ, @prot prot_flags, @flags mmap_flags, @fd I32, @off SZ; RETURN ADDRESS)
  {
    PUSH EBX
    PUSH ESI
    PUSH EDI
    PUSH EBP
    MOV EBX, [ESP+20]
    MOV ECX, [ESP+24]
    MOV EDX, [ESP+28]
    MOV ESI, [ESP+32]
    MOV EDI, [ESP+36]
    MOV EBP, [ESP+40]
    MOV EAX, 192
    INT 0x80
    POP EBP
    POP EDI
    POP ESI
    POP EBX
    RET
  }

  DOC <$ Invokes the Linux ARM EABI mmap system call. $>
  ::mmap ASM_PROCEDURE ARM32
    CALLABLE CALLCONV CCALL(@addr ADDRESS, @len SZ, @prot prot_flags, @flags mmap_flags, @fd I32, @off SZ; RETURN ADDRESS)
  {
    SUB SP, SP, 16
    STR R4, [SP, 0]
    STR R5, [SP, 4]
    STR R7, [SP, 8]
    LDR R4, [SP, 16]
    LDR R5, [SP, 20]
    MOV R7, 192
    SVC 0
    LDR R4, [SP, 0]
    LDR R5, [SP, 4]
    LDR R7, [SP, 8]
    ADD SP, SP, 16
    BX LR
  }

  ::mmap ASM_PROCEDURE ARM64
    CALLABLE CALLCONV CCALL(@addr ADDRESS, @len SZ, @prot prot_flags, @flags mmap_flags, @fd I32, @off SZ; RETURN ADDRESS)
  {
    MOV X8, 222
    SVC 0
    RET
  }

  DOC <$ Invokes Linux mmap2 with the file offset in units of 4096 bytes. $>
  ::mmap ASM_PROCEDURE RISCV32
    CALLABLE CALLCONV CCALL(@addr ADDRESS, @len SZ, @prot prot_flags, @flags mmap_flags, @fd I32, @off SZ; RETURN ADDRESS)
